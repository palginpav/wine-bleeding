diff --git a/tools/build-msi-tables.sh b/tools/build-msi-tables.sh
index 776cdfa2..7c4d5fc5 100644
--- a/tools/build-msi-tables.sh
+++ b/tools/build-msi-tables.sh
@@ -7,7 +7,8 @@ rm -f "${CABFILENAME}" "${TABLEDIR}/*.idt"
 mkdir -p "${TABLEDIR}"
 cp "${TABLESRCDIR}"/*.idt "${TABLEDIR}"
 
-IMAGECABWINPATH=`${WINE} winepath -w "${CABFILENAME}"`
+LOCALCAB_UNIX=`mktemp /tmp/winemono-cab.XXXXXX.cab`
