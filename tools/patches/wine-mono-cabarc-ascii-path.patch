 CONTENTDIR="${TABLEDIR}/cab_contents"
 rm -rf "${CONTENTDIR}"
@@ -58,7 +59,9 @@ mono "$GENFILEHASHES" >> ${TABLEDIR}/msifilehash.idt
 
 cd "${CONTENTDIR}"
 
