#!/usr/bin/env bash
# fake-yad — mock yad for wb-gui tests (M12 + Phase A extension)
#
# Single-response protocol (original, unchanged):
#   $WB_TEST_YAD_RESPONSE     — path to file with canned stdout; if absent/empty, no output.
#   $WB_TEST_YAD_RESPONSE_RC  — desired exit code (default: 0)
#   $WB_TEST_YAD_LOG          — path where this script appends each invocation (one ARGV: line).
#
# Multi-response protocol (Phase A extension — for multi-yad flows):
#   $WB_TEST_YAD_RESPONSES_DIR — path to a directory containing per-invocation files:
#       <n>        — stdout for invocation n  (n is zero-padded to 3 digits: 001, 002, …)
#       <n>.rc     — exit code for invocation n (optional; default 0)
#     A counter file "<dir>/.counter" tracks the current invocation index (starts at 1).
#     Counter reads/increments are protected by flock to handle concurrent plug processes.
#     If a per-invocation file is absent, falls back to WB_TEST_YAD_RESPONSE / RC.
#   When WB_TEST_YAD_RESPONSES_DIR is set it takes precedence over the single-response vars
#   for both stdout content and exit code.
#
# Log format (appended per call):
#   ARGV: <space-separated-quoted-args>
set -euo pipefail

# ---------------------------------------------------------------------------
# Log the invocation
# ---------------------------------------------------------------------------
if [[ -n "${WB_TEST_YAD_LOG:-}" ]]; then
  {
    printf 'ARGV:'
    for arg in "$@"; do
      printf ' %q' "${arg}"
    done
    printf '\n'
  } >> "${WB_TEST_YAD_LOG}"
fi

# ---------------------------------------------------------------------------
# Capture stdin only for widgets that read from stdin (--list, --notebook).
# Other widgets (--form, --info, --entry, --file, --text-info) do NOT read
# from stdin; draining would block when the caller doesn't redirect fd 0.
# Logged as STDIN: lines so tests can assert on piped row content.
# ---------------------------------------------------------------------------
if [[ -n "${WB_TEST_YAD_LOG:-}" ]]; then
  _fake_yad_reads_stdin=0
  for _fy_arg in "$@"; do
    case "${_fy_arg}" in
      --list|--notebook) _fake_yad_reads_stdin=1; break ;;
    esac
  done
  # Drain stdin ONLY for list/notebook widgets AND only when the caller has
  # opted in by setting WB_TEST_YAD_CAPTURE_STDIN=1. Callers that pipe actual
  # data (e.g. preflight's yad --list feed) set it; callers whose stdin is an
  # inherited-but-quiet pipe (most wb-gui subcommands) leave it unset. Without
  # this guard, `cat` blocks forever on the quiet pipe — historical cause of
  # 31/32/36/39-Stage-3 hangs.
  if [[ ${_fake_yad_reads_stdin} -eq 1 ]] \
     && [[ "${WB_TEST_YAD_CAPTURE_STDIN:-0}" == "1" ]] \
     && [[ ! -t 0 ]]; then
    # Bounded read: if stdin is open-but-quiet, give up after 500ms.
    _fake_yad_stdin="$(timeout 0.5 cat 2>/dev/null || true)"
    if [[ -n "${_fake_yad_stdin}" ]]; then
      while IFS= read -r _fy_line; do
        printf 'STDIN: %s\n' "${_fy_line}"
      done <<< "${_fake_yad_stdin}" >> "${WB_TEST_YAD_LOG}"
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Determine response (multi-response takes priority)
# ---------------------------------------------------------------------------
_yad_response=""
_yad_rc="${WB_TEST_YAD_RESPONSE_RC:-0}"

if [[ -n "${WB_TEST_YAD_RESPONSES_DIR:-}" && -d "${WB_TEST_YAD_RESPONSES_DIR}" ]]; then
  local_counter_file="${WB_TEST_YAD_RESPONSES_DIR}/.counter"
  local_lock_file="${WB_TEST_YAD_RESPONSES_DIR}/.lock"

  # Atomically read and increment counter using flock
  # flock is used to prevent concurrent plug processes from racing.
  idx=0
  (
    flock -x 200
    if [[ -f "${local_counter_file}" ]]; then
      idx="$(cat "${local_counter_file}" 2>/dev/null || echo 1)"
    else
      idx=1
    fi
    echo $(( idx + 1 )) > "${local_counter_file}"
    echo "${idx}"
  ) 200>"${local_lock_file}" > /tmp/fake_yad_idx_$$ 2>/dev/null || true
  idx="$(cat /tmp/fake_yad_idx_$$ 2>/dev/null || echo 1)"
  rm -f /tmp/fake_yad_idx_$$ 2>/dev/null || true

  padded="$(printf '%03d' "${idx}")"
  resp_file="${WB_TEST_YAD_RESPONSES_DIR}/${padded}"
  rc_file="${WB_TEST_YAD_RESPONSES_DIR}/${padded}.rc"

  if [[ -f "${resp_file}" ]]; then
    _yad_response="${resp_file}"
  elif [[ -n "${WB_TEST_YAD_RESPONSE:-}" && -f "${WB_TEST_YAD_RESPONSE}" ]]; then
    _yad_response="${WB_TEST_YAD_RESPONSE}"
  fi

  if [[ -f "${rc_file}" ]]; then
    _yad_rc="$(cat "${rc_file}")"
  fi
else
  # Original single-response protocol
  if [[ -n "${WB_TEST_YAD_RESPONSE:-}" && -f "${WB_TEST_YAD_RESPONSE}" ]]; then
    _yad_response="${WB_TEST_YAD_RESPONSE}"
  fi
fi

# Emit canned response
if [[ -n "${_yad_response}" ]]; then
  cat "${_yad_response}"
fi

# Exit with canned exit code
exit "${_yad_rc}"
