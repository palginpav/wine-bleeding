# ---------------------------------------------------------------------------
# _settings_build_gpu_combo <current_json_val> <inherited_label_or_empty>
# Builds ! -separated combo string with current value first.
# If current is empty/null, puts "(inherited: ...)" first.
# ---------------------------------------------------------------------------
_settings_build_gpu_combo() {
  local cur_json="${1:-}"
  local inherited_label="${2:-auto}"

  local cur_label
  cur_label="$(_settings_gpu_json_to_label "${cur_json}")"

  if [[ -z "${cur_label}" ]]; then
    # No override set — put inherited option first
    echo "(inherited: ${inherited_label})!Auto!NVIDIA!AMD!Intel"
  else
    # Override set — put current value first, then inherited option, then rest
    local opts="Auto!NVIDIA!AMD!Intel"
    # Remove current from list and rebuild
    opts="$(echo "${opts}" | sed "s/${cur_label}!//;s/!${cur_label}//")"
    echo "${cur_label}!(inherited: ${inherited_label})!${opts}"
  fi
}

# ---------------------------------------------------------------------------
# _settings_build_winver_combo <current_json_val> <inherited_label_or_empty>
# ---------------------------------------------------------------------------
_settings_build_winver_combo() {
  local cur_json="${1:-}"
  local inherited_label="${2:-Windows 10}"

  local cur_label
  cur_label="$(_settings_winver_json_to_label "${cur_json}")"
  local all_opts="Windows 10!Windows 11!Windows 8.1!Windows 8!Windows 7!Windows XP!Vista"

  if [[ -z "${cur_label}" ]]; then
    echo "(inherited: ${inherited_label})!${all_opts}"
  else
    local trimmed
    trimmed="$(echo "${all_opts}" | sed "s/${cur_label}!//;s/!${cur_label}//")"
    echo "${cur_label}!(inherited: ${inherited_label})!${trimmed}"
  fi
}

# ---------------------------------------------------------------------------
# _cmd_settings_tab_general <yad_key>
# Launch Tab 1 (General) child plug process in background.
# Stores pipe path for output capture.
# Outputs: tab1_pid and _TAB1_PIPE set in caller's scope (via eval from subshell is
# not usable here, so we use a temp file instead).
# ---------------------------------------------------------------------------
_launch_tab_general() {
  local yad_key="${1}"
  local pipe_file="${2}"  # caller-supplied temp file for output

  # Load current values
  local gpu_cur winver_cur debug_cur
  gpu_cur="$(wb_gui_settings_get_general gpu 2>/dev/null || true)"
  winver_cur="$(wb_gui_settings_get_general win_version 2>/dev/null || true)"
  debug_cur="$(wb_gui_settings_get_general wine_debug 2>/dev/null || true)"

  local gpu_label
  gpu_label="$(_settings_gpu_json_to_label "${gpu_cur}")"
  [[ -z "${gpu_label}" ]] && gpu_label="Auto"

  local winver_label
  winver_label="$(_settings_winver_json_to_label "${winver_cur}")"
  [[ -z "${winver_label}" ]] && winver_label="Windows 10"

  local gpu_opts="${gpu_label}!Auto!NVIDIA!AMD!Intel"
  # Remove duplicate if cur matches a default option
  gpu_opts="$(echo "${gpu_opts}" | sed 's/Auto!Auto/Auto/;s/NVIDIA!NVIDIA/NVIDIA/;s/AMD!AMD/AMD/;s/Intel!Intel/Intel/')"

  local winver_opts="${winver_label}!Windows 10!Windows 11!Windows 8.1!Windows 8!Windows 7!Windows XP!Vista"
  winver_opts="${winver_opts//Windows 10!Windows 10/Windows 10}"
  winver_opts="${winver_opts//Windows 11!Windows 11/Windows 11}"
  winver_opts="${winver_opts//Windows 8.1!Windows 8.1/Windows 8.1}"
  winver_opts="${winver_opts//Windows 8!Windows 8/Windows 8}"
  winver_opts="${winver_opts//Windows 7!Windows 7/Windows 7}"
  winver_opts="${winver_opts//Windows XP!Windows XP/Windows XP}"
  winver_opts="${winver_opts//Vista!Vista/Vista}"

  yad --plug="${yad_key}" --tabnum=1 \
    --form --separator="|" --no-markup \
    --field="Default GPU:CB" \
      "${gpu_opts}" \
    --field="Default Windows version:CB" \
      "${winver_opts}" \
    --field="Default WINEDEBUG (leave blank to inherit):TEXT" \
      "${debug_cur}" \
    > "${pipe_file}" 2>/dev/null &
  echo "$!"
}

# ---------------------------------------------------------------------------
# _launch_tab_dist <yad_key> <dist_id_or_empty> <pipe_file>
# Launch Tab 2 (Dist) child plug.
# ---------------------------------------------------------------------------
_launch_tab_dist() {
  local yad_key="${1}"
  local dist_id="${2:-}"
  local pipe_file="${3}"

  if [[ -z "${dist_id}" ]]; then
    # Zero-state (F12 fix): no dist selected or none exist
    yad --plug="${yad_key}" --tabnum=2 \
      --form --no-markup \
      --field="Status:RO" \
        "No dists available. Add your first app using 'Add App' — wb will detect its runtime automatically." \
      > "${pipe_file}" 2>/dev/null &
    echo "$!"
    return
  fi

  # Load dist values
  local dist_name_cur ext_source_cur active_cur last_built_cur gpu_cur
  dist_name_cur="$(wb_gui_settings_get_dist "${dist_id}" name 2>/dev/null || true)"
  [[ -z "${dist_name_cur}" ]] && dist_name_cur="${dist_id}"
  ext_source_cur="$(wb_gui_settings_get_dist "${dist_id}" external_source 2>/dev/null || true)"
  active_cur="$(wb_gui_settings_get_dist "${dist_id}" active 2>/dev/null || true)"
  [[ -z "${active_cur}" ]] && active_cur="false"
  last_built_cur="$(wb_gui_settings_get_dist "${dist_id}" last_built_at 2>/dev/null || true)"
  [[ -z "${last_built_cur}" ]] && last_built_cur="unknown"
  gpu_cur="$(wb_gui_settings_get_dist "${dist_id}" gpu 2>/dev/null || true)"

  # Inherited GPU from general (W4 flag 4: dist layer only has gpu)
  local inherited_gpu
  inherited_gpu="$(wb_gui_settings_get_general gpu 2>/dev/null || true)"
  [[ -z "${inherited_gpu}" ]] && inherited_gpu="auto"
  local inherited_gpu_label
  inherited_gpu_label="$(_settings_gpu_json_to_label "${inherited_gpu}")"
  [[ -z "${inherited_gpu_label}" ]] && inherited_gpu_label="Auto"

  local gpu_opts
  gpu_opts="$(_settings_build_gpu_combo "${gpu_cur}" "${inherited_gpu_label}")"

  yad --plug="${yad_key}" --tabnum=2 \
    --form --separator="|" --no-markup \
    --text="Editing dist: ${dist_id}. Leave a field blank to use the inherited value shown above." \
    --field="Display name:TEXT" \
      "${dist_name_cur}" \
    --field="External source:TEXT" \
      "${ext_source_cur}" \
    --field="Active:RO" \
      "${active_cur}" \
    --field="Last built:RO" \
      "${last_built_cur}" \
    --field="  Inherited from general: ${inherited_gpu_label}:RO" \
      "" \
    --field="GPU override:CB" \
      "${gpu_opts}" \
    > "${pipe_file}" 2>/dev/null &
  echo "$!"
}

