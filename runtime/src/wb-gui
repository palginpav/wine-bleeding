# ---------------------------------------------------------------------------
# Overlay action button callbacks — called by yad :BTN fields via bash -c.
# These run in a subshell spawned by yad; they must source the libs themselves
# and read context from exported env vars (_WB_OVERLAY_APP_ID, etc.).
# ---------------------------------------------------------------------------
_wb_overlay_btn_mangohud() {
  source "${_WB_GUI_LIB_DIR}/wb-gui-dialogs.sh" 2>/dev/null || return 1
  source "${_WB_GUI_LIB_DIR}/wb-gui-overlays.sh" 2>/dev/null || return 1
  source "${_WB_LIB_DIR}/wb-json.sh" 2>/dev/null || return 1
