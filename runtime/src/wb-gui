# ---------------------------------------------------------------------------
# _overlay_conflict_check_and_warn <app_id> <overlays_json>
# Check if any overlay-managed env keys exist in env_vars outside the current
# managed-keys list. Show a one-time info dialog per conflict key (W2 BLK-1).
# Returns 0 always (non-blocking; save proceeds regardless).
# ---------------------------------------------------------------------------
_overlay_conflict_check_and_warn() {
  local app_id="${1:-}"
  local overlays_json="${2:-null}"

  [[ -z "${app_id}" ]] && return 0

  local wb_home
  wb_home="$(_wb_gui_home)"
  local app_file="${wb_home}/settings/apps/${app_id}.json"

  [[ -f "${app_file}" ]] || return 0

  # Current env_vars and managed keys from the app file
  local env_vars_json managed_keys_json
  env_vars_json="$(jq '.env_vars // {}' "${app_file}" 2>/dev/null || echo '{}')"
  managed_keys_json="$(jq '._wb_overlay_managed_env_keys // []' "${app_file}" 2>/dev/null || echo '[]')"

  # Overlay-managed keys the save_env_bake will write
  # These are the canonical overlay env keys per W2 §0 Path B table
  local -a candidate_keys=(MANGOHUD ENABLE_VKBASALT VK_LAYER_PATH LD_LIBRARY_PATH MANGOHUD_CONFIG WINEDLLOVERRIDES)

  local key
  for key in "${candidate_keys[@]}"; do
    # If key is already in the managed list, the bake knows about it — no conflict
    local already_managed
    already_managed="$(printf '%s' "${managed_keys_json}" | jq --arg k "${key}" 'index($k) != null' 2>/dev/null || echo "false")"
    [[ "${already_managed}" == "true" ]] && continue

    # If key is in env_vars (user-set manually), that's a conflict to surface
    local key_val
    key_val="$(printf '%s' "${env_vars_json}" | jq -r --arg k "${key}" '.[$k] // empty' 2>/dev/null || true)"
    [[ -z "${key_val}" ]] && continue

    # Show one info dialog per conflicting key
    wb_gui_dialog_info "wb-gui — Overlay conflict resolved" \
      "The overlay panel removed a conflicting manual setting:
  env_vars.${key} was set to \"${key_val}\"
The overlay toggle is now the source of truth for this setting.
If you need custom configuration, use the overlay panel fields instead."
  done

  return 0
}

# ---------------------------------------------------------------------------
# _overlay_build_version_cb <name>
# Build the :<CB> value string for the version dropdown of an overlay.
# Returns "latest" as sole item when no versions installed (MAJ-2 fix).
# Returns "latest!ver1!ver2..." when installed versions exist.
# ---------------------------------------------------------------------------
_overlay_build_version_cb() {
  local name="${1:-}"
  local reg_file
  reg_file="${WB_HOME:-${XDG_DATA_HOME:-${HOME}/.local/share}/wine-bleeding}/overlays.json"

  if [[ ! -f "${reg_file}" ]]; then
    printf 'latest'
    return 0
  fi

  local ver_list
  ver_list="$(jq -r \
    --arg n "${name}" \
    '.overlays[] | select(.name == $n) | .installed_versions | map(.version) | if length == 0 then "" else ["latest"] + . | join("!") end' \
    "${reg_file}" 2>/dev/null || true)"

  if [[ -z "${ver_list}" ]]; then
    printf 'latest'
  else
    printf '%s' "${ver_list}"
  fi
}

# ---------------------------------------------------------------------------
# _overlay_action_label <name>
# Compute the action-button label for an overlay row based on registry state.
# Outputs: Install | Update | Up to date | Reinstall | Installing...
# ---------------------------------------------------------------------------
_overlay_action_label() {
  local name="${1:-}"
  local reg_file
  reg_file="${WB_HOME:-${XDG_DATA_HOME:-${HOME}/.local/share}/wine-bleeding}/overlays.json"

  if [[ ! -f "${reg_file}" ]]; then
    printf 'Install'
    return 0
  fi

  local entry
  entry="$(jq -c --arg n "${name}" '.overlays[] | select(.name == $n)' "${reg_file}" 2>/dev/null || true)"

  if [[ -z "${entry}" ]]; then
    printf 'Install'
    return 0
  fi

  local broken installed_count available
  broken="$(printf '%s' "${entry}" | jq -r '.broken // false')"
  installed_count="$(printf '%s' "${entry}" | jq '.installed_versions | length' 2>/dev/null || echo 0)"
  available="$(printf '%s' "${entry}" | jq -r '.available_version // empty' 2>/dev/null || true)"

  if [[ "${installed_count}" -eq 0 ]]; then
    printf 'Install'
    return 0
  fi

  if [[ "${broken}" == "true" ]]; then
    printf 'Reinstall'
    return 0
  fi

  # Compare highest installed version to available
  local highest_installed
  highest_installed="$(printf '%s' "${entry}" | jq -r '.installed_versions[0].version // empty' 2>/dev/null || true)"

  if [[ -n "${available}" && -n "${highest_installed}" && "${highest_installed}" != "${available}" ]]; then
    printf 'Update'
  else
    printf 'Up to date'
  fi
}

# ---------------------------------------------------------------------------
# _overlay_last_checked_text
# Compute the "Last checked: ..." label (O23).
# ---------------------------------------------------------------------------
_overlay_last_checked_text() {
  local reg_file
  reg_file="${WB_HOME:-${XDG_DATA_HOME:-${HOME}/.local/share}/wine-bleeding}/overlays.json"

  if [[ ! -f "${reg_file}" ]]; then
    printf 'Last checked: never'
    return 0
  fi

  # Find earliest (min) last_checked_utc across the three overlays
  local min_ts
  min_ts="$(jq -r '[.overlays[].last_checked_utc | select(. != null)] | if length == 0 then "" else sort | .[0] end' \
    "${reg_file}" 2>/dev/null || true)"

  if [[ -z "${min_ts}" ]]; then
    printf 'Last checked: never'
  else
    # Show the UTC timestamp as-is (no relative time calculation in bash)
    printf 'Last checked: %s' "${min_ts}"
  fi
}

# ---------------------------------------------------------------------------
# _overlay_check_all_dialog
# Stage 1 + 2: bulk check-for-updates dialog chain.
# Stage 1: progress dialog while wb_gui_overlays_check_updates runs.
# Stage 2: checklist of available updates (yad --list --checklist).
# Returns 0 if user proceeds to install (sets _OVERLAY_INSTALL_LIST global),
# returns 1 if cancelled or all up-to-date.
# ---------------------------------------------------------------------------
# Global: _OVERLAY_INSTALL_LIST — newline-separated "<name> <version>" pairs
_OVERLAY_INSTALL_LIST=""

_overlay_check_all_dialog() {
  local wb_home
  wb_home="$(_wb_gui_home)"
  local reg_file="${wb_home}/overlays.json"

  # Stage 1: run check in background, show a progress info dialog
  local tmp_check_log
  tmp_check_log="$(mktemp)"

  # Run check_updates in background, log output to temp file
  {
    wb_gui_overlays_check_updates 2>&1 || printf 'CHECK_ERROR\n'
    printf 'CHECK_DONE\n'
  } > "${tmp_check_log}" &
  local check_pid=$!

  # Show a simple info-while-checking progress dialog (Phase C: simpler approach
  # is wb_gui_dialog_log_tail; for check we use yad --info with auto-close)
  wb_gui_yad \
    --title="wb-gui — Checking for overlay updates" \
    --no-markup \
    --text="Checking the internet for newer versions of your game overlays...

Querying GitHub for overlay releases. This usually takes a few seconds." \
    --width=500 --height=160 \
    --image=dialog-information \
    --button="Cancel:1" \
    --timeout=30 \
    --timeout-indicator=top \
    2>/dev/null &
  local progress_yad_pid=$!

  # Wait for check_pid, kill progress dialog when done
  wait "${check_pid}" 2>/dev/null || true
  kill "${progress_yad_pid}" 2>/dev/null || true
  wait "${progress_yad_pid}" 2>/dev/null || true

  # Check if user cancelled (progress_yad closed with rc=1)
  # We just continue regardless since check may have completed already
  rm -f "${tmp_check_log}"

  # Stage 2: read updated registry and show checklist
  if [[ ! -f "${reg_file}" ]]; then
    wb_gui_dialog_error "wb-gui — Check failed" \
      "Cannot reach api.github.com.

Check your network connection and try again."
    return 1
  fi

  # Build checklist rows
  local -a row_data=()
  local all_up_to_date=true
  local net_error=false
  local name
  for name in mangohud vkbasalt optiscaler; do
    local entry
    entry="$(jq -c --arg n "${name}" '.overlays[] | select(.name == $n)' "${reg_file}" 2>/dev/null || true)"
    [[ -z "${entry}" ]] && continue

    local installed_count available last_error
    installed_count="$(printf '%s' "${entry}" | jq '.installed_versions | length' 2>/dev/null || echo 0)"
    available="$(printf '%s' "${entry}" | jq -r '.available_version // "—"' 2>/dev/null || echo '—')"
    last_error="$(printf '%s' "${entry}" | jq -r '.last_check_error // empty' 2>/dev/null || true)"

    local installed_ver="not installed"
    if [[ "${installed_count}" -gt 0 ]]; then
      installed_ver="$(printf '%s' "${entry}" | jq -r '.installed_versions[0].version // "?"' 2>/dev/null || echo '?')"
    fi

    local action_label check_default="FALSE"
    if [[ -n "${last_error}" ]]; then
      action_label="check failed"
      available="—"
      net_error=true
    elif [[ "${installed_ver}" == "not installed" ]]; then
      action_label="install"
      # Only pre-check if available version known
      [[ "${available}" != "—" ]] && check_default="FALSE"  # default unchecked for fresh installs
    elif [[ "${available}" != "—" && "${installed_ver}" != "${available}" ]]; then
      action_label="update"
      check_default="TRUE"
      all_up_to_date=false
    else
      action_label="up to date"
    fi

    local display_name
    case "${name}" in
      mangohud)   display_name="MangoHud" ;;
      vkbasalt)   display_name="VKBasalt" ;;
      optiscaler) display_name="OptiScaler" ;;
      *)          display_name="${name}" ;;
    esac

    row_data+=("${check_default}" "${display_name}" "${installed_ver}" "${available}" "${action_label}" "${name}")
  done

  if [[ "${all_up_to_date}" == "true" && "${net_error}" == "false" ]]; then
    wb_gui_dialog_info "wb-gui — Overlays up to date" \
      "All overlays are at the latest available version."
    return 1
  fi

  local header_text="Check complete. Select overlays to install or update."
  if [[ "${net_error}" == "true" ]]; then
    header_text="${header_text}
Note: one or more overlays could not be checked (network error)."
  fi

  local yad_out rc_cl=0
  yad_out="$(wb_gui_yad \
    --list --checklist \
    --title="wb-gui — Overlay updates available" \
    --text="${header_text}" \
    --no-markup \
    --width=640 --height=300 \
    --separator="|" \
    --print-all \
    --column="Install:CHK" \
    --column="Overlay" \
    --column="Installed" \
    --column="Available" \
    --column="Action" \
    --column="name:HD" \
    --button="Cancel:1" \
    --button="Install selected:0" \
    "${row_data[@]+"${row_data[@]}"}" 2>/dev/null)" || rc_cl=$?

  if [[ "${rc_cl}" -ne 0 ]]; then
    return 1
  fi

  # Collect selected overlays for install
  _OVERLAY_INSTALL_LIST=""
  local chk _display _installed avail _action name_hidden
  while IFS="|" read -r chk _display _installed avail _action name_hidden _trail; do
    [[ "${chk}" == "TRUE" ]] || continue
    [[ -z "${name_hidden}" ]] && continue
    _OVERLAY_INSTALL_LIST+="${name_hidden} ${avail}"$'\n'
  done <<< "${yad_out}"

  if [[ -z "${_OVERLAY_INSTALL_LIST}" ]]; then
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------
# _overlay_run_install_with_log <name> <version>
# Stage 3: run wb_gui_overlays_install for a single overlay with live log tail.
# Reuses Phase B's P1 auto-close pattern (builder exits → kill yad).
# Returns the installer's exit code.
# ---------------------------------------------------------------------------
_overlay_run_install_with_log() {
  local name="${1:-}"
  local version="${2:-latest}"

  local display_name
  case "${name}" in
    mangohud)   display_name="MangoHud" ;;
    vkbasalt)   display_name="VKBasalt" ;;
    optiscaler) display_name="OptiScaler" ;;
    *)          display_name="${name}" ;;
  esac

  local tmp_dir
  tmp_dir="$(mktemp -d)"
  local log_file="${tmp_dir}/wb-overlay-install.log"
  local event_pipe="${tmp_dir}/wb-overlay-events"
  mkfifo "${event_pipe}"

  printf 'Installing %s %s\n' "${display_name}" "${version}" > "${log_file}"

  # Event reader: translate PROGRESS/LOG/WARN/ERROR lines → log file
  _wb_gui_overlay_event_reader() {
    local pipe="${1}"
    local lf="${2}"
    local line prefix_tok rest
    while IFS= read -r line || true; do
      [[ -z "${line}" ]] && continue
      prefix_tok="${line%%: *}"
      rest="${line#*: }"
      case "${prefix_tok}" in
        PROGRESS)
          local pct_str="${rest%% *}"
          local msg_part="${rest#* }"
          if [[ "${pct_str}" =~ ^[0-9]+$ ]]; then
            printf '[%3d%%] %s\n' "${pct_str}" "${msg_part}" >> "${lf}" || true
          fi
          ;;
        LOG)  printf '        %s\n' "${rest}" >> "${lf}" || true ;;
        WARN) printf '  WARN  %s\n' "${rest}" >> "${lf}" || true ;;
        ERROR) printf ' ERROR  %s\n' "${rest}" >> "${lf}" || true ;;
        *) ;;
      esac
    done < "${pipe}" || true
  }
  export -f _wb_gui_overlay_event_reader
  _wb_gui_overlay_event_reader "${event_pipe}" "${log_file}" &
  local reader_pid=$!

  # Start installer in background with progress-fd piped through event_pipe
  local installer_exit=0
  (
    exec 3>"${event_pipe}"
    WB_OVERLAY_PROGRESS_FD=3 wb_gui_overlays_install "${name}" "${version}" \
      >"${log_file}.rawout" 2>&1
  ) &
  local installer_pid=$!

  # Open log-tail dialog (P1 pattern: auto-close when installer exits)
  wb_gui_dialog_log_tail \
    "wb-gui — Installing ${display_name} ${version}" \
    "${log_file}" &
  local yad_pid=$!

  # Poll: either yad closes (user cancel) or installer finishes
  while kill -0 "${yad_pid}" 2>/dev/null && kill -0 "${installer_pid}" 2>/dev/null; do
    sleep "${WB_GUI_BUILD_POLL_SEC:-0.3}"
  done

  if kill -0 "${installer_pid}" 2>/dev/null; then
    # yad closed first — user cancelled; SIGTERM → 5s watchdog → SIGKILL
    kill -TERM -- "-${installer_pid}" 2>/dev/null || kill -TERM "${installer_pid}" 2>/dev/null || true
    local watchdog_secs=5 elapsed=0
    while kill -0 "${installer_pid}" 2>/dev/null && [[ "${elapsed}" -lt "${watchdog_secs}" ]]; do
      sleep 1; (( elapsed++ )) || true
    done
    kill -0 "${installer_pid}" 2>/dev/null && kill -KILL "${installer_pid}" 2>/dev/null || true
  else
    # Installer finished — drain briefly, close yad
    sleep "${WB_GUI_BUILD_TAIL_DRAIN_SEC:-0.5}"
    kill "${yad_pid}" 2>/dev/null || true
  fi

  wait "${yad_pid}" 2>/dev/null || true
  wait "${installer_pid}" 2>/dev/null || installer_exit=$?

  # SIGKILL — the reader's `while read ... || true` loop defeats EOF.
  kill -9 "${reader_pid}" 2>/dev/null || true
  wait "${reader_pid}" 2>/dev/null || true

  rm -rf "${tmp_dir}" 2>/dev/null || true
  return "${installer_exit}"
}

# ---------------------------------------------------------------------------
# _overlay_install_selected_flow <name_ver_list_newline>
# Stage 3 (sequential) + Stage 4 summary for a set of overlays.
# Each line of name_ver_list: "<name> <version>"
# ---------------------------------------------------------------------------
_overlay_install_selected_flow() {
  local name_ver_list="${1:-}"

  local -a succeeded=() failed=()
  local line name ver

  while IFS= read -r line; do
    [[ -z "${line}" ]] && continue
    name="${line%% *}"
    ver="${line#* }"
    [[ -z "${ver}" || "${ver}" == "${name}" ]] && ver="latest"

    local rc_install=0
    _overlay_run_install_with_log "${name}" "${ver}" || rc_install=$?

    local display_name
    case "${name}" in
      mangohud)   display_name="MangoHud" ;;
      vkbasalt)   display_name="VKBasalt" ;;
      optiscaler) display_name="OptiScaler" ;;
      *)          display_name="${name}" ;;
    esac

    case "${rc_install}" in
      0)    succeeded+=("${display_name} ${ver}") ;;
      2)    failed+=("${display_name}: cancelled") ;;
      72)   failed+=("${display_name}: GitHub rate limit reached (60 req/hr). Try again later or set GITHUB_TOKEN. Your token may be throttled by GitHub organization policies. Try again later or check your token scopes at github.com/settings/tokens.") ;;
      73)   failed+=("${display_name}: cannot reach api.github.com. Check your network connection and try again.") ;;
      74)   failed+=("${display_name}: SHA256 mismatch — the downloaded archive did not match the expected checksum. Usually a temporary network or CDN issue. Try again, or report at the project tracker if it persists.") ;;
      *)    failed+=("${display_name}: installation failed (code ${rc_install}). Run fetch-overlay.sh from a terminal for details.") ;;
    esac
  done <<< "${name_ver_list}"

  # Stage 4: summary dialog
  local summary_text="Overlay installation complete."
  if [[ "${#succeeded[@]}" -gt 0 ]]; then
    summary_text+="

Installed successfully:"
    local item
    for item in "${succeeded[@]}"; do
      summary_text+="
  ${item}"
    done
    summary_text+="

Your per-app overlay settings have been updated. Changes take effect on the next game launch."
  fi

  if [[ "${#failed[@]}" -gt 0 ]]; then
    summary_text+="

Could not install:"
    local item
    for item in "${failed[@]}"; do
      summary_text+="
  ${item}"
    done
  fi

  wb_gui_dialog_info "wb-gui — Install complete" "${summary_text}"
}

# ---------------------------------------------------------------------------
# _overlay_single_update_flow <name> <available_version>
# Flow C2 (MAJ-1 fix): single-overlay update — skip Stage 2 checklist,
# show a direct confirm-and-install dialog for that one overlay.
# ---------------------------------------------------------------------------
_overlay_single_update_flow() {
  local name="${1:-}"
  local available_version="${2:-}"

  local display_name
  case "${name}" in
    mangohud)   display_name="MangoHud" ;;
    vkbasalt)   display_name="VKBasalt" ;;
    optiscaler) display_name="OptiScaler" ;;
    *)          display_name="${name}" ;;
  esac

  local wb_home
  wb_home="$(_wb_gui_home)"
  local reg_file="${wb_home}/overlays.json"

  local installed_ver="not installed"
  if [[ -f "${reg_file}" ]]; then
    local installed_count
    installed_count="$(jq --arg n "${name}" \
      '.overlays[] | select(.name == $n) | .installed_versions | length' \
      "${reg_file}" 2>/dev/null || echo 0)"
    if [[ "${installed_count:-0}" -gt 0 ]]; then
      installed_ver="$(jq -r --arg n "${name}" \
        '.overlays[] | select(.name == $n) | .installed_versions[0].version' \
        "${reg_file}" 2>/dev/null || echo '?')"
    fi
  fi

  # Check for available update first if we don't know the version
  if [[ -z "${available_version}" || "${available_version}" == "—" ]]; then
    wb_gui_overlays_check_updates "${name}" 2>/dev/null || true
    if [[ -f "${reg_file}" ]]; then
      available_version="$(jq -r --arg n "${name}" \
        '.overlays[] | select(.name == $n) | .available_version // empty' \
        "${reg_file}" 2>/dev/null || true)"
    fi
  fi

  if [[ -z "${available_version}" ]]; then
    wb_gui_dialog_error "wb-gui — Check failed" \
      "Cannot reach api.github.com.

Check your network connection and try again."
    return 1
  fi

  local confirm_text
  if [[ "${installed_ver}" == "not installed" ]]; then
    confirm_text="${display_name} ${available_version} is available.
Install now?"
  else
    confirm_text="${display_name} ${installed_ver} is installed.
${display_name} ${available_version} is available.
Install now?"
  fi

  local rc_confirm=0
  wb_gui_yad \
    --title="wb-gui — ${display_name} update available" \
    --no-markup \
    --image=dialog-question \
    --text="${confirm_text}" \
    --button="Cancel:1" \
    --button="Install:0" 2>/dev/null || rc_confirm=$?

  [[ "${rc_confirm}" -ne 0 ]] && return 1

  local install_list="${name} ${available_version}"
  _overlay_install_selected_flow "${install_list}"
}

