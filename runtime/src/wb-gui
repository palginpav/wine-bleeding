# ---------------------------------------------------------------------------
# _dist_build_rows <dists_json_array>
# Render yad --list row data from a dists JSON array (from wb_gui_dist_registry_list).
# Each row: ACTIVE | NAME | SOURCE | WINE | LAST BUILT | PATH:HD | BROKEN:HD
# ACTIVE marker: ">" for active, "!" for broken, blank otherwise.
# ---------------------------------------------------------------------------
_dist_build_rows() {
  local dists_json="${1:-[]}"
  local count
  count="$(printf '%s' "${dists_json}" | jq 'length')"
  local i
  for (( i=0; i<count; i++ )); do
    local entry active broken source name path wine_ver last_built broken_reason
    entry="$(printf '%s' "${dists_json}" | jq -c ".[${i}]")"
    active="$(printf '%s' "${entry}" | jq -r '.active')"
    broken="$(printf '%s' "${entry}" | jq -r '.broken')"
    source="$(printf '%s' "${entry}" | jq -r '.source')"
    name="$(printf '%s' "${entry}" | jq -r '.name')"
    path="$(printf '%s' "${entry}" | jq -r '.path')"
    wine_ver="$(printf '%s' "${entry}" | jq -r '.wine_version // empty')"
    [[ -z "${wine_ver}" ]] && wine_ver="?"
    broken_reason="$(printf '%s' "${entry}" | jq -r '.broken_reason // empty')"

    # LAST BUILT: ISO date from last_built_at or built_utc; em-dash for external/null
    local last_built="—"
    local lb_raw
    lb_raw="$(printf '%s' "${entry}" | jq -r '.last_built_at // empty')"
    if [[ -n "${lb_raw}" && "${lb_raw}" != "null" ]]; then
      # Truncate to YYYY-MM-DD
      last_built="${lb_raw:0:10}"
    fi

    # ACTIVE marker — visible enough to be read at a glance. The single ">"
    # was easy to miss in a narrow first column; "ACTIVE" is unambiguous.
    local active_marker=""
    if [[ "${broken}" == "true" ]]; then
      active_marker="BROKEN"
    elif [[ "${active}" == "true" ]]; then
      active_marker="ACTIVE"
    fi

    printf '%s\n' "${active_marker}" "${name}" "${source}" "${wine_ver}" \
      "${last_built}" "${path}" "${broken}"
  done
}

# ---------------------------------------------------------------------------
# _dist_get_selected_fields <yad_out>
# Parse a yad --list output line (separator "|") into dist fields.
# Outputs: name|source|path|broken|active (one per line for easy read)
# ---------------------------------------------------------------------------
_dist_get_selected_fields() {
  local yad_out="${1:-}"
  # Row: ACTIVE|NAME|SOURCE|WINE|LAST_BUILT|PATH|BROKEN_FLAG
  local _active name source _wine _lb path broken _trail
  IFS='|' read -r _active name source _wine _lb path broken _trail <<< "${yad_out}"
  printf '%s\n' "${name}" "${source}" "${path}" "${broken}"
}

# ---------------------------------------------------------------------------
# _cmd_build_component <dist_name> <dist_path>
# Multi-select Component Builder (W4): preflight gate + DXVK/VKD3D/NVAPI
# checklist + sequential build loop per selected component.
# Calls tools/build-component.sh with --progress-fd 3 for event parsing.
# Cancel: SIGTERM to process group → 5s watchdog → SIGKILL (W2 OQ-4).
# ---------------------------------------------------------------------------
_cmd_build_component() {
  local dist_name="${1:-}"
  local dist_path="${2:-}"
  local wb_home
  wb_home="$(_wb_gui_home)"

  # -------------------------------------------------------------------------
  # Build-env preflight gate (W4 integration point 1)
  # Silent pass-through when overall_ok=true (BLK-1 resolution).
  # WB_GUI_SKIP_PREFLIGHT=1 lets bats fixtures bypass the dialog — otherwise
  # a missing mingw in the test environment injects an extra yad invocation
  # that consumes a fake-yad response slot and shifts all subsequent Stage 1
  # responses by one, leading to an infinite validation loop.
  # -------------------------------------------------------------------------
  if [[ "${WB_GUI_SKIP_PREFLIGHT:-0}" != "1" ]]; then
    local preflight_rc=0
    wb_gui_dialog_preflight_loop "Component Builder" "components" || preflight_rc=$?
    if [[ "${preflight_rc}" -ne 0 ]]; then
      # User cancelled preflight — return to Dist Manager list
      return 0
    fi
  fi

  # -------------------------------------------------------------------------
  # Stage 1 loop — multi-select checklist; keep form open on validation fail
  # -------------------------------------------------------------------------
  while true; do
    # Read current component versions from dists.json for display
    local reg_file="${wb_home}/dists.json"
    local v_dxvk="—" v_vkd3d="—" v_nvapi="—"
    if [[ -r "${reg_file}" ]]; then
      local comp_versions
      comp_versions="$(jq -c --arg n "${dist_name}" \
        '.dists[] | select(.name == $n) | .component_versions // {}' \
        "${reg_file}" 2>/dev/null | head -1 || true)"
      if [[ -n "${comp_versions}" ]]; then
        local _v
        _v="$(printf '%s' "${comp_versions}" | jq -r '.dxvk // empty' 2>/dev/null || true)"
        [[ -n "${_v}" ]] && v_dxvk="${_v}"
        _v="$(printf '%s' "${comp_versions}" | jq -r '.vkd3d // empty' 2>/dev/null || true)"
        [[ -n "${_v}" ]] && v_vkd3d="${_v}"
        _v="$(printf '%s' "${comp_versions}" | jq -r '.nvapi // empty' 2>/dev/null || true)"
        [[ -n "${_v}" ]] && v_nvapi="${_v}"
      fi
    fi

    # Stage 1: multi-select component checklist (W4 — replaces old single-CB)
    local s1_out rc_s1=0
    s1_out="$(wb_gui_yad \
      --form \
      --title="Build Components — ${dist_name}" \
      --text="Rebuild one or more components. Each builds in a sibling staging dir and atomically swaps in — the dist stays usable during the build." \
      --no-markup \
      --separator="|" \
      --field="Target dist::RO"                              "${dist_name}" \
      --field="DXVK  (current: ${v_dxvk})::CHK"             "FALSE" \
      --field="VKD3D-Proton  (current: ${v_vkd3d})::CHK"    "FALSE" \
      --field="DXVK-NVAPI  (current: ${v_nvapi})::CHK"      "FALSE" \
      --field="Force rebuild all (ignore cache)::CHK"        "FALSE" \
      --field="Note: gstreamer is bundled from your system's gstreamer-1.0 install. To refresh it, re-run tools/full-build.sh or update your system's gstreamer packages.::LBL" "" \
      --button="Cancel:1" \
      --button="Start build:0" 2>/dev/null)" || rc_s1=$?

    case "${rc_s1}" in
      1|252)
        return 0
        ;;
      0)
        : # proceed to validate
        ;;
      *)
        return 0
        ;;
    esac

    # Parse Stage 1 stdout:
    # <dist_ro>|<dxvk_chk>|<vkd3d_chk>|<nvapi_chk>|<force_chk>|
    local _dist_ro dxvk_chk vkd3d_chk nvapi_chk force_chk _trail
    IFS='|' read -r _dist_ro dxvk_chk vkd3d_chk nvapi_chk force_chk _trail \
      <<< "${s1_out}"

    # Validation: at least one component selected
    if [[ "${dxvk_chk}" != "TRUE" && "${vkd3d_chk}" != "TRUE" && "${nvapi_chk}" != "TRUE" ]]; then
      wb_gui_dialog_error "No component selected" \
        "Select at least one component to build."
      continue  # Loop back to Stage 1
    fi

    # Build the ordered list of selected components (fixed order: dxvk → vkd3d → nvapi)
    local -a selected_components=()
    [[ "${dxvk_chk}" == "TRUE" ]]  && selected_components+=("dxvk")
    [[ "${vkd3d_chk}" == "TRUE" ]] && selected_components+=("vkd3d")
    [[ "${nvapi_chk}" == "TRUE" ]] && selected_components+=("nvapi")

    local force_flag=""
    [[ "${force_chk}" == "TRUE" ]] && force_flag="--force-rebuild"

    # Pre-flight guard 1: dist still exists
    if [[ ! -d "${dist_path}" ]]; then
      wb_gui_dialog_error "Dist Not Found" \
        "The selected dist no longer exists. Refreshing the list."
      wb_gui_dist_registry_refresh
      return 0
    fi

    # Pre-flight guard 2: bin/wine still present
    if [[ ! -x "${dist_path}/bin/wine" ]]; then
      wb_gui_dialog_error "Dist Broken" \
        "This dist appears broken (bin/wine is missing). Refreshing the list."
      wb_gui_dist_registry_refresh
      return 0
    fi

    # Pre-flight guard 3: build lock not already held
    local build_lock_file="${wb_home}/.build-lock"
    if flock -n "${build_lock_file}" true 2>/dev/null; then
      : # lock is available — proceed
    else
      wb_gui_dialog_error "Build Already in Progress" \
        "Another build is already running. Wait for it to finish or cancel it from the other window."
      continue
    fi

    # All guards passed — proceed to Stage 2 multi-component loop
    break
  done  # Stage 1 loop

  # -------------------------------------------------------------------------
  # Locate build-component.sh
  # -------------------------------------------------------------------------
  local build_script=""
  if [[ -n "${_WB_TOOLS_DIR}" ]] && [[ -x "${_WB_TOOLS_DIR}/build-component.sh" ]]; then
    build_script="${_WB_TOOLS_DIR}/build-component.sh"
  elif command -v build-component.sh &>/dev/null; then
    build_script="$(command -v build-component.sh)"
  fi
  if [[ -z "${build_script}" || ! -x "${build_script}" ]]; then
    wb_gui_dialog_error "Build Error" \
      "Cannot locate tools/build-component.sh.

What happened: the wine-bleeding build driver is not installed or WB_TOOLS_DIR is not pointing at a directory that contains it.
Expected: /usr/lib/wine-bleeding/tools/build-component.sh (system install) or ./tools/build-component.sh (source tree).
Next action: reinstall wine-bleeding-wb (the RPM/DEB now ships this file) or set WB_TOOLS_DIR=<path-to-tools>."
    return 1
  fi

  # -------------------------------------------------------------------------
  # Stage 2 — Single shared log window; iterate selected components
  # -------------------------------------------------------------------------
  local tmp_dir
  tmp_dir="$(mktemp -d)"
  local log_file="${tmp_dir}/wb-build-log.txt"
  local event_pipe="${tmp_dir}/wb-build-events"
  mkfifo "${event_pipe}"

  local comp_total="${#selected_components[@]}"
  printf 'Building %d component(s) on %s\n' "${comp_total}" "${dist_name}" > "${log_file}"

  # Event reader (shared across all component iterations)
  _wb_gui_dist_event_reader() {
    local pipe="${1}"
    local lf="${2}"
    local line prefix_tok rest pct_str
    while IFS= read -r line || true; do
      [[ -z "${line}" ]] && continue
      prefix_tok="${line%%: *}"
      rest="${line#*: }"
      case "${prefix_tok}" in
        PROGRESS)
          pct_str="${rest%% *}"
          local msg_part="${rest#* }"
          if [[ "${pct_str}" =~ ^[0-9]+$ ]]; then
            printf '[%3d%%] %s\n' "${pct_str}" "${msg_part}" >> "${lf}" || true
          fi
          ;;
        LOG)   printf '        %s\n' "${rest}" >> "${lf}" || true ;;
        WARN)  printf '  WARN  %s\n' "${rest}" >> "${lf}" || true ;;
        ERROR) printf ' ERROR  %s\n' "${rest}" >> "${lf}" || true ;;
        *)     ;;
      esac
    done < "${pipe}" || true
  }
  export -f _wb_gui_dist_event_reader
  _wb_gui_dist_event_reader "${event_pipe}" "${log_file}" &
  local reader_pid=$!

  # Open the shared log-tail window (stays open across all components)
  wb_gui_dialog_log_tail \
    "Building ${comp_total} component(s) — ${dist_name}" \
    "${log_file}" &
  local yad_pid=$!

  # -------------------------------------------------------------------------
  # Iterate components: dxvk → vkd3d → nvapi
  # -------------------------------------------------------------------------
  local -a build_results=()   # "OK", "FAILED:<exit>", "SKIPPED" per component
  local comp_n=0

  local component_arg
  for component_arg in "${selected_components[@]}"; do
    (( comp_n++ )) || true

    # Map arg to display name
    local comp_display
    case "${component_arg}" in
      dxvk)  comp_display="DXVK" ;;
      vkd3d) comp_display="VKD3D-Proton" ;;
      nvapi) comp_display="DXVK-NVAPI" ;;
      *)     comp_display="${component_arg}" ;;
    esac

    # If yad was already cancelled by user, skip remaining components
    if ! kill -0 "${yad_pid}" 2>/dev/null; then
      build_results+=("SKIPPED")
      continue
    fi

    # Separator header in log
    {
      printf '\n'
      printf '%s\n' "════════════════════════════════════════════════════════"
      printf ' Building %s (%d of %d)\n' "${comp_display}" "${comp_n}" "${comp_total}"
      printf '%s\n' "════════════════════════════════════════════════════════"
    } >> "${log_file}"

    local raw_out="${tmp_dir}/rawout-${component_arg}.txt"

    # Launch build-component.sh; WB_SKIP_PREFLIGHT=1 avoids double-preflight
    (
      exec 3>"${event_pipe}"
      export WB_SKIP_PREFLIGHT=1
      exec "${build_script}" \
        --component "${component_arg}" \
        --target-dist "${dist_path}" \
        --progress-fd 3 \
        ${force_flag} \
        >"${raw_out}" 2>&1
    ) &
    local builder_pid=$!

    # Poll until yad closes (cancel) or this builder finishes
    while kill -0 "${yad_pid}" 2>/dev/null && kill -0 "${builder_pid}" 2>/dev/null; do
      sleep "${WB_GUI_BUILD_POLL_SEC:-0.3}"
    done

    if kill -0 "${builder_pid}" 2>/dev/null; then
      # User cancelled — stop current build
      kill -TERM -- "-${builder_pid}" 2>/dev/null || true
      local elapsed=0
      while kill -0 "${builder_pid}" 2>/dev/null && [[ "${elapsed}" -lt 5 ]]; do
        sleep 1; (( elapsed++ )) || true
      done
      kill -KILL -- "-${builder_pid}" 2>/dev/null || true
      wait "${builder_pid}" 2>/dev/null || true
      build_results+=("SKIPPED")
      # Skip remaining components
      while [[ "${comp_n}" -lt "${comp_total}" ]]; do
        build_results+=("SKIPPED")
        (( comp_n++ )) || true
      done
      break
    else
      local comp_exit=0
      wait "${builder_pid}" 2>/dev/null || comp_exit=$?
      if [[ "${comp_exit}" -eq 0 ]]; then
        build_results+=("OK")
      else
        build_results+=("FAILED:${comp_exit}")
      fi
    fi
  done

  # Drain log, close yad window
  sleep "${WB_GUI_BUILD_TAIL_DRAIN_SEC:-0.5}"
  kill "${yad_pid}" 2>/dev/null || true
  wait "${yad_pid}" 2>/dev/null || true
  kill -9 "${reader_pid}" 2>/dev/null || true
  wait "${reader_pid}" 2>/dev/null || true

  # -------------------------------------------------------------------------
  # Stage 4 — Aggregated result dialog
  # -------------------------------------------------------------------------

  # Refresh registry to get new versions
  wb_gui_dist_registry_refresh 2>/dev/null || true

  # Count outcomes
  local ok_count=0 fail_count=0 skip_count=0
  local result_str
  for result_str in "${build_results[@]+"${build_results[@]}"}"; do
    case "${result_str}" in
      OK)      (( ok_count++ ))   || true ;;
      SKIPPED) (( skip_count++ )) || true ;;
      FAILED*) (( fail_count++ )) || true ;;
    esac
  done

  local summary_line
  if [[ "${ok_count}" -eq "${comp_total}" ]]; then
    summary_line="${ok_count} of ${comp_total} components rebuilt successfully."
  elif [[ "${ok_count}" -eq 0 && "${fail_count}" -eq 0 ]]; then
    summary_line="Build cancelled before any component started."
  elif [[ "${ok_count}" -eq 0 ]]; then
    summary_line="All component builds failed. The dist has not changed."
  else
    local partial_msg="${ok_count} of ${comp_total} rebuilt."
    [[ "${fail_count}" -gt 0 ]] && \
      partial_msg+=" ${fail_count} failed — dist is still usable for the successful components."
    [[ "${skip_count}" -gt 0 ]] && \
      partial_msg+=" ${skip_count} skipped (cancelled)."
    summary_line="${partial_msg}"
  fi

  # Per-component rows
  local result_body=""
  local ri=0
  for component_arg in "${selected_components[@]+"${selected_components[@]}"}"; do
    local comp_display
    case "${component_arg}" in
      dxvk)  comp_display="DXVK" ;;
      vkd3d) comp_display="VKD3D-Proton" ;;
      nvapi) comp_display="DXVK-NVAPI" ;;
      *)     comp_display="${component_arg}" ;;
    esac

    local res="${build_results[${ri}]:-SKIPPED}"
    local glyph new_ver=""
    if [[ "${res}" == "OK" ]]; then
      glyph="OK"
      if [[ -r "${wb_home}/dists.json" ]]; then
        new_ver="$(jq -r --arg n "${dist_name}" --arg c "${component_arg}" \
          '.dists[] | select(.name == $n) | .component_versions[$c] // empty' \
          "${wb_home}/dists.json" 2>/dev/null | head -1 || true)"
      fi
      result_body+="  ${glyph}      ${comp_display}   -> ${new_ver:-?}"$'\n'
    elif [[ "${res}" == FAILED:* ]]; then
      glyph="FAILED"
      local exit_code="${res#FAILED:}"
      result_body+="  ${glyph}  ${comp_display}   build failed (exit ${exit_code})"$'\n'
    else
      glyph="SKIPPED"
      result_body+="  ${glyph} ${comp_display}   (cancelled by user)"$'\n'
    fi
    (( ri++ )) || true
  done

  wb_gui_dialog_info "Build complete — ${dist_name}" \
    "${summary_line}

${result_body}"

  # Cleanup
  rm -rf "${tmp_dir}" 2>/dev/null || true
}

