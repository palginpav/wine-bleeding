# ---------------------------------------------------------------------------
# _cmd_build_dist_from_source
# Build-Dist-from-Source wizard: 4-stage flow (C.1 source-tree picker →
# C.2 preflight → C.3 live log → C.4 result).
# Entry point: Dist Manager [Build Dist from Source...] button (rc=80).
# ---------------------------------------------------------------------------
_cmd_build_dist_from_source() {
  local wb_home
  wb_home="$(_wb_gui_home)"

  # -------------------------------------------------------------------------
  # Locate full-build.sh
  # -------------------------------------------------------------------------
  local full_build_script=""
  if [[ -n "${_WB_TOOLS_DIR}" ]] && [[ -x "${_WB_TOOLS_DIR}/full-build.sh" ]]; then
    full_build_script="${_WB_TOOLS_DIR}/full-build.sh"
  fi
  if [[ -z "${full_build_script}" || ! -x "${full_build_script}" ]]; then
    wb_gui_dialog_error "Build Dist from Source" \
      "Cannot locate tools/full-build.sh.

What happened: the wine-bleeding full-build driver is not installed.
Expected: /usr/lib/wine-bleeding/tools/full-build.sh (system install) or ./tools/full-build.sh (source tree).
Next action: reinstall wine-bleeding-wb or set WB_TOOLS_DIR=<path-to-tools>."
    return 1
  fi

  # -------------------------------------------------------------------------
  # Stage 1 — Source-tree picker (C.1)
  # -------------------------------------------------------------------------
  # Default path: $WB_WINE_SOURCE_ROOT if set, else $WB_HOME/src/wine-bleeding/
  local default_src_path="${WB_WINE_SOURCE_ROOT:-${wb_home}/src/wine-bleeding}"
  local src_path="${default_src_path}"
  local validation_copy=""

  _validate_src_tree() {
    local p="${1:-}"
    if [[ -z "${p}" ]]; then
      echo "Enter or browse to a wine-bleeding source directory."
      return 1
    elif [[ -x "${p}/tools/full-build.sh" ]]; then
      echo "Source tree found. tools/full-build.sh present and executable."
      return 0
    else
      echo "Not a wine-bleeding tree — tools/full-build.sh not found. Choose a different directory or clone upstream."
      return 1
    fi
  }

  local stage1_error_prefix=""
  while true; do
    validation_copy="$(_validate_src_tree "${src_path}" 2>/dev/null || true)"

    local s1_out rc_s1=0
    s1_out="$(wb_gui_yad \
      --form \
      --title="Build Dist from Source — Step 1 of 4: Choose source tree" \
      --text="${stage1_error_prefix}Choose a wine-bleeding source tree to build from.
We will run tools/full-build.sh against it to produce a new dist
under \$WB_HOME/dist/WINE-BLEEDING-<date>." \
      --no-markup \
      --separator="|" \
      --field="Source tree::DIR"                                "${src_path}" \
      --field="Validation::RO"                                  "${validation_copy}" \
      --field="Clone upstream (github.com/palginpav/wine-bleeding)::BTN" \
        "@bash -c '_wb_gui_build_dist_clone_handler'" \
      --field="Note: cloning downloads ~500 MB. Skip if you already have a source tree.::LBL" "" \
      --button="Cancel:1" \
      --button="Next:0" 2>/dev/null)" || rc_s1=$?

    case "${rc_s1}" in
      1|252) return 0 ;;
      0) : ;;
      *) return 0 ;;
    esac

    src_path="$(printf '%s' "${s1_out}" | cut -d'|' -f1)"

    # Validate before proceeding
    if ! _validate_src_tree "${src_path}" >/dev/null 2>&1; then
      stage1_error_prefix="The path you entered is not a wine-bleeding source tree (tools/full-build.sh not found). Please choose a valid directory or clone upstream.

"
      continue
    fi

    stage1_error_prefix=""
    break
  done

  # -------------------------------------------------------------------------
  # Stage 2 — Preflight gate (C.2): reuse preflight loop with dist build-type
  # -------------------------------------------------------------------------
  local pf_rc=0
  # Loop; on cancel: return to stage 1 (loop again)
  while true; do
    wb_gui_dialog_preflight_loop "Build Dist from Source" "dist" || pf_rc=$?
    if [[ "${pf_rc}" -ne 0 ]]; then
      # User cancelled preflight — go back to stage 1
      stage1_error_prefix=""
      return 0   # For simplicity, exit wizard; Stage 1 re-entry would require outer loop
    fi
    break
  done

  # -------------------------------------------------------------------------
  # Stage 3 — Live log (C.3)
  # -------------------------------------------------------------------------
  # Check build lock before starting
  local build_lock_file="${wb_home}/.build-lock"
  if ! flock -n "${build_lock_file}" true 2>/dev/null; then
    wb_gui_dialog_error "Build already in progress" \
      "Another build is already running.
Wait for it to finish or cancel it, then try again."
    return 1
  fi

  local tmp_dir
  tmp_dir="$(mktemp -d)"
  local log_file="${tmp_dir}/wb-full-build-log.txt"
  local raw_out="${log_file}.rawout"
  local event_pipe="${tmp_dir}/wb-full-build-events"
  mkfifo "${event_pipe}"

  printf 'Building dist from source — %s\n' "${src_path}" > "${log_file}"

  # Event reader (same pattern)
  _wb_gui_full_build_event_reader() {
    local pipe="${1}" lf="${2}" line prefix_tok rest pct_str
    while IFS= read -r line || true; do
      [[ -z "${line}" ]] && continue
      prefix_tok="${line%%: *}"
      rest="${line#*: }"
      case "${prefix_tok}" in
        PROGRESS)
          pct_str="${rest%% *}"
          local msg_part="${rest#* }"
          if [[ "${pct_str}" =~ ^[0-9]+$ ]]; then
            printf '[%3d%%] %s\n' "${pct_str}" "${msg_part}" >> "${lf}" || true
          fi
          ;;
        LOG)   printf '        %s\n' "${rest}" >> "${lf}" || true ;;
        WARN)  printf '  WARN  %s\n' "${rest}" >> "${lf}" || true ;;
        ERROR) printf ' ERROR  %s\n' "${rest}" >> "${lf}" || true ;;
        *)     ;;
      esac
    done < "${pipe}" || true
  }
  export -f _wb_gui_full_build_event_reader
  _wb_gui_full_build_event_reader "${event_pipe}" "${log_file}" &
  local reader_pid=$!

  # Track last PROGRESS and last ERROR for Stage 4 failure dialog
  local last_progress_label="" last_error_line=""
  _wb_gui_track_last_progress() {
    local lf="${1}" src_path="${2}"
    local line
    # Tail the raw_out for PROGRESS/ERROR lines as builder writes them
    tail -f "${src_path}" 2>/dev/null | while IFS= read -r line; do
      case "${line%%: *}" in
        PROGRESS) printf '%s\n' "${line#PROGRESS: }" > "${lf}.last_progress" || true ;;
        ERROR)    printf '%s\n' "${line#ERROR: }"    > "${lf}.last_error"    || true ;;
      esac
    done
  }
  export -f _wb_gui_track_last_progress

  # Launch full-build.sh
  (
    exec 3>"${event_pipe}"
    export WB_BUILD_PROGRESS_FD=3
    export WB_WINE_SOURCE_ROOT="${src_path}"
    "${full_build_script}" \
      --progress-fd 3 \
      >"${raw_out}" 2>&1
  ) &
  local builder_pid=$!

  # Start tracker in parallel
  _wb_gui_track_last_progress "${log_file}" "${raw_out}" &
  local tracker_pid=$!

  wb_gui_dialog_log_tail "Building dist from source — Step 3 of 4" "${log_file}" &
  local yad_pid=$!

  while kill -0 "${yad_pid}" 2>/dev/null && kill -0 "${builder_pid}" 2>/dev/null; do
    sleep "${WB_GUI_BUILD_POLL_SEC:-0.3}"
  done

  if kill -0 "${builder_pid}" 2>/dev/null; then
    # User cancelled
    kill -TERM -- "-${builder_pid}" 2>/dev/null || true
    local elapsed=0
    while kill -0 "${builder_pid}" 2>/dev/null && [[ "${elapsed}" -lt 5 ]]; do
      sleep 1; (( elapsed++ )) || true
    done
    kill -KILL -- "-${builder_pid}" 2>/dev/null || true
  else
    sleep "${WB_GUI_BUILD_TAIL_DRAIN_SEC:-0.5}"
    kill "${yad_pid}" 2>/dev/null || true
  fi

  wait "${yad_pid}" 2>/dev/null || true
  local full_build_exit=0
  wait "${builder_pid}" 2>/dev/null || full_build_exit=$?
  kill -9 "${tracker_pid}" 2>/dev/null || true; wait "${tracker_pid}" 2>/dev/null || true
  kill -9 "${reader_pid}" 2>/dev/null || true;  wait "${reader_pid}" 2>/dev/null || true

  # Read tracking sentinel files
  [[ -r "${log_file}.last_progress" ]] && \
    last_progress_label="$(cat "${log_file}.last_progress" 2>/dev/null || true)"
  [[ -r "${log_file}.last_error" ]] && \
    last_error_line="$(cat "${log_file}.last_error" 2>/dev/null || true)"

  # -------------------------------------------------------------------------
  # Stage 4 — Post-build result (C.4)
  # -------------------------------------------------------------------------
  if [[ "${full_build_exit}" -eq 0 ]]; then
    # Success: find new dist in $WB_HOME/dist/
    wb_gui_dist_registry_refresh 2>/dev/null || true

    local new_dist_name="—" new_dist_path="—"
    # Find newest dist dir created today (WINE-BLEEDING-YYYYMMDD pattern)
    local today
    today="$(date +%Y%m%d)"
    local candidate="${wb_home}/dist/WINE-BLEEDING-${today}"
    if [[ -d "${candidate}" ]]; then
      new_dist_name="WINE-BLEEDING-${today}"
      new_dist_path="${candidate}"
    fi

    local result_text="Build complete.

New dist:    ${new_dist_name}
Path:        ${new_dist_path}"

    local stage4_out rc_s4=0
    stage4_out="$(wb_gui_yad \
      --form \
      --title="Dist built — Step 4 of 4" \
      --no-markup \
      --image=dialog-information \
      --text="${result_text}" \
      --separator="|" \
      --field="Activate this dist now (swap the WINE-BLEEDING symlink)::CHK" "TRUE" \
      --button="Done:0" 2>/dev/null)" || rc_s4=$?

    if [[ "${rc_s4}" -eq 0 ]]; then
      local activate_chk
      activate_chk="$(printf '%s' "${stage4_out}" | cut -d'|' -f1)"
      if [[ "${activate_chk}" == "TRUE" && "${new_dist_name}" != "—" ]]; then
        wb_gui_dist_activate "${new_dist_name}" 2>/dev/null || \
          wb_gui_dialog_error "Activate Failed" \
            "Could not activate '${new_dist_name}'. You can activate it manually from the Dist Manager."
      fi
    fi
  else
    # Failure
    local tail_lines=""
    if [[ -r "${raw_out}" ]]; then
      tail_lines="$(tail -n 30 "${raw_out}" 2>/dev/null || true)"
    fi
    local fail_text="Build failed at step: ${last_progress_label:-unknown}

What happened: tools/full-build.sh exited with code ${full_build_exit}.
Why: ${last_error_line:-see log below}

What to do next:
  Open a terminal and run:
    tools/full-build.sh 2>&1 | tee /tmp/wb-build.log
  to see the full error in context.

Or click Back to re-run preflight if a tool is missing.

Last 30 lines of log:
${tail_lines}"

    local rc_fail=0
    wb_gui_yad \
      --title="Build failed — Step 4 of 4" \
      --no-markup \
      --image=dialog-error \
      --text="${fail_text}" \
      --button="Back to preflight:10" \
      --button="Close:1" 2>/dev/null || rc_fail=$?

    if [[ "${rc_fail}" -eq 10 ]]; then
      # Back to preflight → recurse (same source tree)
      rm -rf "${tmp_dir}" 2>/dev/null || true
      # Re-enter wizard from preflight stage
      _cmd_build_dist_from_source
      return
    fi
  fi

  rm -rf "${tmp_dir}" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# _cmd_dist_manager — Dist Manager dialog (Phase B main flow).
# Opened from main window button Dists (rc=70).
# Loops: Add External / Activate / Build Components / Remove / Refresh / Close.
# ---------------------------------------------------------------------------
_cmd_dist_manager() {
  local wb_home
  wb_home="$(_wb_gui_home)"

  # Always refresh before showing the list (Flow 1)
  wb_gui_dist_registry_refresh 2>/dev/null || true

  while true; do
    # Build row data from registry
    local dists_json
    dists_json="$(wb_gui_dist_registry_list)"
    local -a row_data=()
    local row
    while IFS= read -r row; do
      row_data+=("${row}")
    done < <(_dist_build_rows "${dists_json}")

    # Placeholder when no dists registered
    if [[ "${#row_data[@]}" -eq 0 ]]; then
      row_data=(
        "" "No dists registered" "" "" "" "" "false"
      )
    fi

    local yad_out rc_dm=0
    yad_out="$(wb_gui_yad \
      --list \
      --title="wine-bleeding — Dists" \
      --text="Manage Wine distributions known to wb-gui." \
      --no-markup \
      --column="ACTIVE" \
      --column="NAME" \
      --column="SOURCE" \
      --column="WINE" \
      --column="LAST BUILT" \
      --column="PATH:HD" \
      --column="BROKEN:HD" \
      --print-all \
      --separator="|" \
      --button="Add External!list-add:10" \
      --button="Activate!emblem-default:20" \
      --button="Build Components!applications-development:30" \
      --button="Build Dist from Source...:80" \
      --button="Remove!list-remove:40" \
      --button="Refresh!view-refresh:50" \
      --button="Close!window-close:1" \
      "${row_data[@]+"${row_data[@]}"}" 2>/dev/null)" || rc_dm=$?

    case "${rc_dm}" in
      # ------------------------------------------------------------------
      1|252)
        # Close / Escape — back to main window
        break
        ;;
      # ------------------------------------------------------------------
      10)
        # Add External Dist — folder picker + name form
        # B-2 fix: form loops on validation failure (never closes on error)
        local ae_path="" ae_name=""
        while true; do
          local ae_out rc_ae=0
          ae_out="$(wb_gui_yad \
            --form \
            --title="Add External Dist" \
            --text="Register a Wine build that lives outside \$WB_HOME/dist/. wb will validate it and add it to the registry." \
            --no-markup \
            --separator="|" \
            --field="Path to Wine root:DIR"  "${ae_path}" \
            --field="Display name:TEXT"      "${ae_name}" \
            --field="Expected: <path>/bin/wine must exist and be executable.:LBL" "" \
            --button="Cancel:1" \
            --button="Register:0" 2>/dev/null)" || rc_ae=$?

          if [[ "${rc_ae}" -ne 0 ]]; then
            break  # Cancel — back to [LIST]
          fi

          ae_path="$(printf '%s' "${ae_out}" | cut -d'|' -f1)"
          ae_name="$(printf '%s' "${ae_out}" | cut -d'|' -f2)"

          # Auto-fill name from path basename if empty
          if [[ -z "${ae_name}" && -n "${ae_path}" ]]; then
            ae_name="$(basename "${ae_path}")"
          fi

          # Validation: path non-empty and absolute
          if [[ -z "${ae_path}" ]] || [[ "${ae_path}" != /* ]]; then
            wb_gui_dialog_error "No path entered" \
              "No path entered. Enter the full path to the Wine build root."
            continue
          fi

          # Validation: path must exist and be a directory
          if [[ ! -d "${ae_path}" ]]; then
            wb_gui_dialog_error "Path not found" \
              "That path does not exist or is not a folder. Check the path and try again."
            continue
          fi

          # Validation: name must match allowed pattern
          if [[ ! "${ae_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
            wb_gui_dialog_error "Invalid name" \
              "Display name can only contain letters, digits, dots, hyphens, and underscores. Edit the name and try again."
            continue
          fi

          # Validation: bin/wine must exist and be executable
          if [[ ! -x "${ae_path}/bin/wine" ]]; then
            wb_gui_dialog_error "No Wine executable" \
              "No Wine executable found at ${ae_path}/bin/wine. Make sure the path points to a Wine build root, not a prefix or game folder."
            continue
          fi

          # Validation: name not already registered
          local reg_file="${wb_home}/dists.json"
          if [[ -r "${reg_file}" ]]; then
            local already
            already="$(jq -r --arg n "${ae_name}" \
              '.dists[] | select(.name == $n) | .name' "${reg_file}" 2>/dev/null | head -1 || true)"
            if [[ -n "${already}" ]]; then
              wb_gui_dialog_error "Name already registered" \
                "A dist named '${ae_name}' is already registered. Choose a different display name."
              continue
            fi
          fi

          # All pre-validation passed — call backend (canonical security gate)
          local add_err
          add_err="$(wb_gui_dist_add_external "${ae_path}" "${ae_name}" 2>&1)" || {
            wb_gui_dialog_error "Registration failed" \
              "Registration failed: ${add_err}. Check the path and try again."
            continue
          }

          wb_gui_dialog_info "Registered" \
            "Registered '${ae_name}' successfully."
          break
        done
        # Refresh already done by wb_gui_dist_add_external on success; loop
        continue
        ;;
      # ------------------------------------------------------------------
      20)
        # Activate
        # Row: ACTIVE|NAME|SOURCE|WINE|LAST_BUILT|PATH|BROKEN
        local a_name="" a_broken=""
        local _am="" _an="" _as="" _aw="" _alb="" _ap="" _ab="" _trail=""
        IFS='|' read -r _am _an _as _aw _alb _ap _ab _trail <<< "${yad_out}"
        a_name="${_an}"; a_broken="${_ab}"

        if [[ -z "${a_name}" || "${a_name}" == "No dists registered" ]]; then
          wb_gui_dialog_info "Activate" "Select a dist row first."
          continue
        fi

        # Guard: already active
        # Check from registry
        local a_is_active
        a_is_active="$(jq -r --arg n "${a_name}" \
          '.dists[] | select(.name == $n) | .active' \
          "${wb_home}/dists.json" 2>/dev/null | head -1 || true)"
        if [[ "${a_is_active}" == "true" ]]; then
          wb_gui_dialog_info "Already active" \
            "${a_name} is already the active dist."
          continue
        fi

        # Guard: broken
        if [[ "${a_broken}" == "true" ]]; then
          local br_reason
          br_reason="$(jq -r --arg n "${a_name}" \
            '.dists[] | select(.name == $n) | .broken_reason // "unknown"' \
            "${wb_home}/dists.json" 2>/dev/null | head -1 || true)"
          wb_gui_dialog_error "Cannot Activate" \
            "${a_name} cannot be activated because it is broken: ${br_reason}.

Fix or remove this dist, then try again."
          continue
        fi

        # Activate
        local act_err act_rc=0
        act_err="$(wb_gui_dist_activate "${a_name}" 2>&1)" || act_rc=$?
        if [[ "${act_rc}" -ne 0 ]]; then
          wb_gui_dialog_error "Activate Failed" \
            "Failed to activate '${a_name}': ${act_err}."
        else
          # Confirm to the user — silent success was being read as "nothing
          # happened" because the active-row marker is easy to miss on first
          # glance. Registry has already been refreshed by wb_gui_dist_activate.
          wb_gui_dialog_info "Activated" \
            "${a_name} is now the active distribution.

The dist list now shows ACTIVE in the first column for this row."
        fi
        continue
        ;;
      # ------------------------------------------------------------------
      30)
        # Build Components
        local _bm bn _bs _bw _blb bp bb _btrail
        IFS='|' read -r _bm bn _bs _bw _blb bp bb _btrail <<< "${yad_out}"

        if [[ -z "${bn}" || "${bn}" == "No dists registered" ]]; then
          wb_gui_dialog_info "Build Components" "Select a dist row first."
          continue
        fi

        # Guard: not rebuildable. `rebuildable` is derived from the dist's
        # on-disk layout (bin/wine + lib/wine/x86_64-windows/ + writable),
        # independent of how the dist was registered. This lets externally-
        # added full-build.sh dists rebuild components, while still rejecting
        # dists shipped by distros (read-only layout) or with missing pieces.
        local bld_rebuildable
        bld_rebuildable="$(jq -r --arg n "${bn}" \
          '.dists[] | select(.name == $n) | .rebuildable // false' \
          "${wb_home}/dists.json" 2>/dev/null | head -1 || echo "false")"
        if [[ "${bld_rebuildable}" != "true" ]]; then
          wb_gui_dialog_error "Dist cannot be rebuilt" \
            "${bn} does not have the full-build.sh layout or is not writable.

Expected: bin/wine + lib/wine/x86_64-windows/ under a user-writable path.
If this dist came from your distro's package manager, it is intentionally read-only; build a native dist via tools/full-build.sh and register it to rebuild components."
          continue
        fi

        # Guard: broken dist
        if [[ "${bb}" == "true" ]]; then
          local bld_br_reason
          bld_br_reason="$(jq -r --arg n "${bn}" \
            '.dists[] | select(.name == $n) | .broken_reason // "unknown"' \
            "${wb_home}/dists.json" 2>/dev/null | head -1 || true)"
          wb_gui_dialog_error "Dist is broken" \
            "${bn} is broken: ${bld_br_reason}.

Fix or remove this dist before attempting a component build."
          continue
        fi

        # Open Component Builder (blocks until all 3 stages complete)
        _cmd_build_component "${bn}" "${bp}"

        # Refresh registry after builder exits (Flow 5 spec: always refresh)
        wb_gui_dist_registry_refresh 2>/dev/null || true
        continue
        ;;
      # ------------------------------------------------------------------
      40)
        # Remove
        local _rm="" rn="" rs="" _rw="" _rlb="" rp="" _rb="" _rtrail=""
        IFS='|' read -r _rm rn rs _rw _rlb rp _rb _rtrail <<< "${yad_out}"

        if [[ -z "${rn}" || "${rn}" == "No dists registered" ]]; then
          wb_gui_dialog_info "Remove" "Select a dist row first."
          continue
        fi

        # Guard: active dist (B-1 fix: name the dist, give next action)
        local r_is_active
        r_is_active="$(jq -r --arg n "${rn}" \
          '.dists[] | select(.name == $n) | .active' \
          "${wb_home}/dists.json" 2>/dev/null | head -1 || true)"
        if [[ "${r_is_active}" == "true" ]]; then
          wb_gui_dialog_error "Cannot Remove Active Dist" \
            "${rn} is currently active.

Activate a different dist first, then remove this one."
          continue
        fi

        # App count for confirmation dialog
        local r_app_count
        r_app_count="$(wb_gui_dist_apps_count "${rn}" 2>/dev/null || echo 0)"
        local r_apps_line
        if [[ "${r_app_count}" -eq 0 ]]; then
          r_apps_line="No apps are attached to this dist."
        else
          r_apps_line="Apps:    ${r_app_count}  (they will need a runtime reassigned before they can run)"
        fi

        # Source-specific confirmation dialog
        local rc_confirm=0
        if [[ "${rs}" == "native" ]]; then
          wb_gui_yad \
            --title="Remove Dist" \
            --no-markup \
            --image=dialog-warning \
            --text="You are about to permanently delete this distribution:

  Name:    ${rn}
  Path:    ${rp}
  ${r_apps_line}

The dist files will be deleted from disk. Your apps and their prefixes
are not affected, but they will need a new runtime selected before
you can launch them." \
            --button="Cancel:1" \
            --button="Delete permanently:0" 2>/dev/null || rc_confirm=$?
        else
          wb_gui_yad \
            --title="Unregister External Dist" \
            --no-markup \
            --image=dialog-question \
            --text="Remove this external distribution from wb's registry?

  Name:    ${rn}
  Path:    ${rp}
  ${r_apps_line}

The files at that path are NOT deleted — only the registry entry is
removed. You can re-add this dist later from the same path." \
            --button="Cancel:1" \
            --button="Unregister:0" 2>/dev/null || rc_confirm=$?
        fi

        if [[ "${rc_confirm}" -ne 0 ]]; then
          continue  # Cancelled — back to [LIST]
        fi

        # Perform removal
        local rem_err
        rem_err="$(wb_gui_dist_remove "${rn}" 2>&1)" || {
          wb_gui_dialog_error "Remove Failed" \
            "Could not remove '${rn}': ${rem_err}."
        }
        # Registry already refreshed by wb_gui_dist_remove
        continue
        ;;
      # ------------------------------------------------------------------
      50)
        # Refresh
        wb_gui_dist_registry_refresh 2>/dev/null || true
        continue
        ;;
      # ------------------------------------------------------------------
      80)
        # Build Dist from Source... — 4-stage wizard (W4 integration point 2)
        _cmd_build_dist_from_source
        wb_gui_dist_registry_refresh 2>/dev/null || true
        continue
        ;;
      # ------------------------------------------------------------------
      *)
        break
        ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# _cmd_main_window — the main app library window (Phase A rework)
# ---------------------------------------------------------------------------
_cmd_main_window() {
  _wb_gui_load_libs
  # Phase A: migrate games.json → apps.json on first run (idempotent)
  wb_gui_apps_migrate_from_games >/dev/null 2>&1 || true
  # Phase A: purge stale detection snapshot dirs (crash recovery)
  wb_detect_sweep_stale 24 >/dev/null 2>&1 || true
  _wb_gui_place_desktop_shortcut
  # Phase C: one-time "New in v1.8.0" overlay discoverability banner (W2 BLK-3)
  _overlay_phase_c_banner

  while true; do
    # Build app rows for this iteration
    local -a row_data=()
    local row
    while IFS= read -r row; do
      row_data+=("${row}")
    done < <(_gui_build_app_rows)

    # Placeholder when no apps registered
    if [[ "${#row_data[@]}" -eq 0 ]]; then
      row_data=("No apps registered" "" "" "" "" "")
    fi

    # Main list window
    # Columns: NAME | PREFIX | RUNTIME | LAST PLAYED | (hidden) ID | (hidden) EXE
    local yad_out yad_rc=0
    yad_out="$(wb_gui_yad \
      --list \
      --title="wine-bleeding — apps" \
      --text="Double-click an app to launch it." \
      --column="NAME" \
      --column="PREFIX" \
      --column="RUNTIME" \
      --column="LAST PLAYED" \
      --column="ID:HD" \
      --column="EXE:HD" \
      --print-all \
      --separator="|" \
      --button="Add App!list-add:10" \
      --button="Run!media-playback-start:20" \
      --button="Settings!document-properties:30" \
      --button="Remove!list-remove:40" \
      --button="Refresh!view-refresh:50" \
      --button="Prefs!preferences-system:60" \
      --button="Dists!drive-harddisk:70" \
      --button="Close!window-close:1" \
      "${row_data[@]+"${row_data[@]}"}" 2>/dev/null)" || yad_rc=$?

    case "${yad_rc}" in
      1|252)
        # Close or window-manager close
        break
        ;;
      10)
        # Add App button
        _cmd_add_app
        ;;
      20|0)
        # Run button or double-click (exit 0)
        local sel_name sel_prefix _sel_rt _sel_lp sel_id sel_exe
        IFS='|' read -r sel_name sel_prefix _sel_rt _sel_lp sel_id sel_exe <<< "${yad_out}"
        if [[ -z "${sel_id}" || "${sel_name}" == "No apps registered" ]]; then
          wb_gui_dialog_info "Run" "Please select an app first."
        else
          _gui_launch_app "${sel_exe}" "${sel_prefix}" || {
            wb_gui_dialog_error "Launch Failed" \
              "Wine exited non-zero for '${sel_name}'.\nCheck wb log for details."
          }
        fi
        ;;
      30)
        # Settings button (per-row → Per-App tab)
        local _sel_n sel_pfx _sel_rt2 _sel_lp2 sel_id2 _sel_exe2
        IFS='|' read -r _sel_n sel_pfx _sel_rt2 _sel_lp2 sel_id2 _sel_exe2 <<< "${yad_out}"
        if [[ -z "${sel_id2}" || "${sel_pfx}" == "" ]]; then
          wb_gui_dialog_info "Settings" "Please select an app first."
        else
          _cmd_settings_v2 app "${sel_id2}"
        fi
        ;;
      40)
        # Remove button
        local _n2 _p2 _r2 _l2 sel_id3 _e3
        IFS='|' read -r _n2 _p2 _r2 _l2 sel_id3 _e3 <<< "${yad_out}"
        if [[ -n "${sel_id3}" && "${_n2}" != "No apps registered" ]]; then
          _gui_remove_app "${sel_id3}"
        else
          wb_gui_dialog_info "Remove" "Please select an app first."
        fi
        ;;
      50)
        # Refresh — loop again
        continue
        ;;
      60)
        # Prefs button → 4-pane dialog at General tab
        _cmd_settings_v2 general
        ;;
      70)
        # Dists button → Dist Manager dialog (Phase B)
        _cmd_dist_manager
        ;;
      *)
        # Unknown; treat as close
        break
        ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# usage
# ---------------------------------------------------------------------------
_usage() {
  cat <<EOF
wb-gui ${WB_GUI_VERSION} -- wine-bleeding GUI launcher

Usage:
  wb-gui                         Open main app-library window
  wb-gui add-app                 Add an app (2-choice dialog)
  wb-gui add-portable [<exe>]    Register a portable/pre-installed app
  wb-gui detect <prefix>         Run post-install detection for a prefix
  wb-gui settings-v2 [<scope> <id>]  Open 4-pane settings dialog
                                 scope: general | dist <id> | prefix <id> | app <id>
  wb-gui add-game [<exe>]        Legacy alias: register a game (add-portable)
  wb-gui settings <prefix>       Legacy alias: per-prefix settings
  wb-gui --version               Print version
  wb-gui --help                  Show this help

Phase B (v1.7.0):
  Main window [Dists] button     Open Dist Manager (rc=70)

Phase B / W4 (v1.7.x):
  Dist Manager [Build Components]          Multi-select DXVK/VKD3D/NVAPI build with preflight gate
  Dist Manager [Build Dist from Source...] Build a full dist via tools/full-build.sh (4-stage wizard)

This tool requires yad (install: apt/dnf install yad).
EOF
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
  local subcommand="${1:-}"

  case "${subcommand}" in
    --version)
      _cmd_version
      ;;
    --help|-h|help)
      _usage
      ;;
    add-app)
      shift
      _cmd_add_app "$@"
      ;;
    add-portable)
      shift
      _cmd_add_portable "$@"
      ;;
    detect)
      shift
      _cmd_detect "${1:-}"
      ;;
    settings-v2)
      shift
      _cmd_settings_v2 "${1:-general}" "${2:-}"
      ;;
    # Legacy aliases — preserved for 24_gui.bats backward compat
    add-game)
      shift
      _cmd_add_game "${1:-}"
      ;;
    settings)
      shift
      _cmd_settings "${1:-}"
      ;;
    "")
      # No subcommand: open main window
      if ! command -v yad >/dev/null 2>&1; then
        echo "wb-gui: yad is not installed. Install with: apt install yad / dnf install yad" >&2
        exit 1
      fi
      _cmd_main_window
      ;;
    *)
      echo "wb-gui: unknown subcommand '${subcommand}'" >&2
      _usage >&2
      exit 1
      ;;
  esac
}

main "$@"
