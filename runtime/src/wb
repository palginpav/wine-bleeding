  _wb_validate_path_arg "prefix reconcile" "${prefix_name}"
  _wb_load_wineboot_lib

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"

  local prefix_path
  if [[ "${prefix_name}" == /* ]]; then
    prefix_path="${prefix_name}"
  else
    prefix_path="${wb_home}/prefixes/${prefix_name}"
  fi

  local before_manifest="${prefix_path}/.wb_components"
