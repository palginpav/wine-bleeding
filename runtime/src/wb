  local prefix_name="${1:-}"
  if [[ -z "${prefix_name}" ]]; then
    prefix_name="${WB_PREFIX:-}"
  fi
  if [[ -z "${prefix_name}" ]]; then
    echo "wb prefix reconcile: NAME required" >&2
