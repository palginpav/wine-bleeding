  _wb_conf_set_key "${conf}" "WB_MULTIBUILD" "1"
  echo "multi-build mode enabled; 'wb runtime list --multi' now shows all dists and 'wb run --runtime NAME' is available"
}

cmd_config_disable_multibuild() {
