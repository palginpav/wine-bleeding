# ---------------------------------------------------------------------------
# cmd_prefix_migrate: wb prefix migrate --from-portproton [NAME] [options]
# Copies a PP prefix into $WB_HOME/prefixes/<NAME>, then adopts it (take-over).
# PP original is NEVER modified.
# ---------------------------------------------------------------------------
cmd_prefix_migrate() {
  local pp_name=""
  local pp_path_override=""
  local overwrite=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from-portproton)
        pp_name="${2:-}"
        shift 2
        ;;
      --from-portproton=*)
        pp_name="${1#--from-portproton=}"
        shift
        ;;
      --pp-path)
        pp_path_override="${2:-}"
        shift 2
        ;;
      --pp-path=*)
        pp_path_override="${1#--pp-path=}"
        shift
        ;;
      --overwrite)
        overwrite=1
        shift
        ;;
      *)
        echo "wb prefix migrate: unknown option '$1'" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "${pp_name}" ]]; then
    echo "wb prefix migrate: NAME required (use --from-portproton NAME)" >&2
    exit 1
  fi

  _wb_validate_path_arg "prefix migrate" "${pp_name}"

  local pp_root
  if [[ -n "${pp_path_override}" ]]; then
    pp_root="${pp_path_override}"
  elif [[ -n "${PORT_WINE_PATH:-}" ]]; then
    pp_root="${PORT_WINE_PATH}"
  else
    pp_root="${HOME}/PortProton"
  fi

  local pp_prefix="${pp_root}/data/prefixes/${pp_name}"
  if [[ ! -d "${pp_prefix}" ]]; then
    echo "wb prefix migrate: PP prefix not found: ${pp_prefix}" >&2
    exit 1
  fi

  _wb_load_prefix_lib

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
  local wb_prefix="${wb_home}/prefixes/${pp_name}"

  if [[ -d "${wb_prefix}" ]]; then
    if [[ "${overwrite}" -eq 0 ]]; then
      echo "wb prefix migrate: target already exists: ${wb_prefix}" >&2
      echo "wb prefix migrate: use --overwrite to replace it" >&2
      exit 1
    fi
    rm -rf "${wb_prefix}"
  fi

  mkdir -p "${wb_home}/prefixes"

  # COPY (never move) — acceptance criterion 16.2.
  # SECURITY: scan for symlinks that resolve outside the source tree BEFORE
  # copying; a hostile PP prefix could contain symlinks pointing into user
  # $HOME or system paths, and cp -a would reproduce them so that subsequent
  # Wine operations follow them. Reject if found.
  if _wb_migrate_has_escape_symlink "${pp_prefix}"; then
    echo "wb prefix migrate: PP prefix contains symlinks escaping its tree; aborting for safety" >&2
    exit 1
  fi

  echo "Copying ${pp_prefix} -> ${wb_prefix} ..."
  cp -a "${pp_prefix}" "${wb_prefix}"

  # Adopt in take-over mode
  wb_prefix_adopt "${wb_prefix}" --take-over

  echo "migrated: ${pp_name} (PP original untouched)"
}

# ---------------------------------------------------------------------------
# cmd_prefix_export: wb prefix export --to-portproton <NAME> [options]
# Copies a wb prefix into PP's prefixes/<NAME>. PP original is never moved.
# ---------------------------------------------------------------------------
cmd_prefix_export() {
  local wb_name=""
  local pp_path_override=""
  local overwrite=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to-portproton)
        wb_name="${2:-}"
        shift 2
        ;;
      --to-portproton=*)
        wb_name="${1#--to-portproton=}"
        shift
        ;;
      --pp-path)
        pp_path_override="${2:-}"
        shift 2
        ;;
      --pp-path=*)
        pp_path_override="${1#--pp-path=}"
        shift
        ;;
      --overwrite)
        overwrite=1
        shift
        ;;
      *)
        echo "wb prefix export: unknown option '$1'" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "${wb_name}" ]]; then
    echo "wb prefix export: NAME required (use --to-portproton NAME)" >&2
    exit 1
  fi

  _wb_validate_path_arg "prefix export" "${wb_name}"

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
  local wb_prefix="${wb_home}/prefixes/${wb_name}"

  if [[ ! -d "${wb_prefix}" ]]; then
    echo "wb prefix export: wb prefix not found: ${wb_prefix}" >&2
    exit 1
  fi

  local pp_root
  if [[ -n "${pp_path_override}" ]]; then
    pp_root="${pp_path_override}"
  elif [[ -n "${PORT_WINE_PATH:-}" ]]; then
    pp_root="${PORT_WINE_PATH}"
  else
    pp_root="${HOME}/PortProton"
  fi

  local pp_prefix_dir="${pp_root}/data/prefixes"
  local pp_prefix="${pp_prefix_dir}/${wb_name}"

  if [[ -d "${pp_prefix}" ]]; then
    if [[ "${overwrite}" -eq 0 ]]; then
      echo "wb prefix export: target already exists: ${pp_prefix}" >&2
      echo "wb prefix export: use --overwrite to replace it" >&2
      exit 1
    fi
    rm -rf "${pp_prefix}"
  fi

  mkdir -p "${pp_prefix_dir}"

  # SECURITY: same escape-symlink scan as migrate — refuse to propagate
  # out-of-tree symlinks from wb into the PP directory.
  if _wb_migrate_has_escape_symlink "${wb_prefix}"; then
    echo "wb prefix export: wb prefix contains symlinks escaping its tree; aborting for safety" >&2
    exit 1
  fi

  echo "Copying ${wb_prefix} -> ${pp_prefix} ..."
  cp -a "${wb_prefix}" "${pp_prefix}"
  echo "exported: ${wb_name} -> ${pp_prefix}"
}

# Walk a prefix tree; return 0 if any symlink resolves outside the tree root,
# else return 1. Used by migrate/export to refuse hostile content propagation.
_wb_migrate_has_escape_symlink() {
  local root="$1"
  local root_real
  root_real="$(realpath -m "${root}")/"
  local link
  while IFS= read -r link; do
    [[ -n "${link}" ]] || continue
    local target
    target="$(realpath -m "${link}")"
    if [[ "${target}" != "${root_real}"* ]]; then
      echo "wb: escape-symlink detected: ${link} -> ${target}" >&2
      return 0
    fi
  done < <(find "${root}" -type l 2>/dev/null)
  return 1
}

# ---------------------------------------------------------------------------
# cmd_install: wb install <action>
# ---------------------------------------------------------------------------
cmd_install() {
  local action="${1:-}"
  case "${action}" in
    portproton-plugin)
      # Resolve install.sh path relative to the installed wb location.
      # wb lives at $WB_HOME/bin/wb (standalone) or PP tree; install.sh is at
      # $WB_HOME/../runtime/install.sh in standalone mode, or alongside runtime/
      # in source. We walk up from BASH_SOURCE[0]'s directory.
      local wb_bin_dir
      wb_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
      # In standalone install: wb_bin_dir = $WB_HOME/bin; install.sh is at
      # $WB_HOME/../install.sh (if installed from source) or at parent runtime/.
      # Try a few known locations:
      local install_sh=""
      local candidate
      for candidate in \
        "${wb_bin_dir}/../install.sh" \
        "${wb_bin_dir}/../../runtime/install.sh" \
        "${wb_bin_dir}/../../install.sh"; do
        if [[ -f "${candidate}" ]]; then
          install_sh="$(cd "$(dirname "${candidate}")" && pwd)/$(basename "${candidate}")"
          break
        fi
      done
      if [[ -z "${install_sh}" ]]; then
        echo "wb install portproton-plugin: cannot locate install.sh" >&2
        exit 1
      fi
      exec bash "${install_sh}" --portproton-plugin
      ;;
    "")
      echo "wb install: action required (e.g. portproton-plugin)" >&2
      exit 1
      ;;
    *)
      echo "wb install: unknown action '${action}'" >&2
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# cmd_run: wb run <exe> [--prefix NAME] [--runtime NAME] [--wait] [args...]
# Implements the full §5.2 call graph.
# ---------------------------------------------------------------------------
cmd_run() {
  local exe=""
  local prefix_name=""
  local runtime_name=""
  local do_wait=0
  local yes_wineboot=0
  local -a extra_args=()

  # Parse arguments: --prefix, --runtime, --wait, --yes-wineboot are options
  # recognized anywhere before `--`; the first non-option positional is the exe;
  # everything after the exe (or after `--`) is forwarded verbatim to wine.
  local saw_exe=0
  local past_separator=0
  while [[ $# -gt 0 ]]; do
    if [[ "${past_separator}" -eq 1 ]]; then
      extra_args+=("$1")
      shift
      continue
    fi
    if [[ "${saw_exe}" -eq 1 ]]; then
      # After we have the exe, still scan for wb-own flags; rest goes to wine.
      case "$1" in
        --prefix)
          prefix_name="${2:-}"
          shift 2
          ;;
        --prefix=*)
          prefix_name="${1#--prefix=}"
          shift
          ;;
        --runtime)
          runtime_name="${2:-}"
          shift 2
          ;;
        --runtime=*)
          runtime_name="${1#--runtime=}"
          shift
          ;;
        --yes-wineboot)
          yes_wineboot=1
          shift
          ;;
        --wait)
          do_wait=1
          shift
          ;;
        --)
          past_separator=1
          shift
          ;;
        *)
          extra_args+=("$1")
          shift
          ;;
      esac
    else
      case "$1" in
        --prefix)
          prefix_name="${2:-}"
          shift 2
          ;;
        --prefix=*)
          prefix_name="${1#--prefix=}"
          shift
          ;;
        --runtime)
          runtime_name="${2:-}"
          shift 2
          ;;
        --runtime=*)
          runtime_name="${1#--runtime=}"
          shift
          ;;
        --yes-wineboot)
          yes_wineboot=1
          shift
          ;;
        --wait)
          do_wait=1
          shift
          ;;
        --)
          past_separator=1
          shift
          ;;
        -*)
          echo "wb run: unknown option '$1'" >&2
          exit 1
          ;;
        *)
          exe="$1"
          saw_exe=1
          shift
          ;;
      esac
    fi
  done

  if [[ -z "${exe}" ]]; then
    echo "wb run: <exe> required" >&2
    exit 1
  fi

  _wb_load_run_lib

  # Step 1: Validate exe argument (path traversal check)
  _wb_validate_path_arg "run" "${exe}"

  # Step 2: Load config (5-layer config system)
  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
  wb_config_load

  # Step 3: Resolve runtime (dist path)
  local dist_path

  # M9/M13: if --runtime NAME given, check multi-build gating first
  if [[ -n "${runtime_name}" ]]; then
    _wb_validate_path_arg "run --runtime" "${runtime_name}"
    # Check if multi-build is enabled; if not, and the requested runtime differs
    # from the alias, refuse.
    if ! wb_multibuild_enabled; then
      # Resolve the WINE-BLEEDING alias target name for comparison
      local alias_real
      alias_real="$(readlink -f "${wb_home}/dist/WINE-BLEEDING" 2>/dev/null || true)"
      local alias_name
      alias_name="$(basename "${alias_real}" 2>/dev/null || true)"
      if [[ "${runtime_name}" != "WINE-BLEEDING" && "${runtime_name}" != "${alias_name}" ]]; then
        echo "wb run: multi-build not enabled; run 'wb config enable-multibuild' first" >&2
        exit 1
      fi
    fi
    # M13: use extended resolver (dist/ wins over plugins/runtimes.d/)
    if ! dist_path="$(wb_runtime_resolve "${runtime_name}" 2>/dev/null)"; then
      echo "wb run: runtime '${runtime_name}' not found in dist/ or plugin registry" >&2
      exit 1
    fi
  elif [[ -n "${WB_RUNTIME:-}" && "${WB_RUNTIME}" != "WINE-BLEEDING" ]]; then
    if ! dist_path="$(wb_runtime_resolve "${WB_RUNTIME}" 2>/dev/null)"; then
      echo "wb run: WB_RUNTIME '${WB_RUNTIME}' not found in dist/ or plugin registry" >&2
      exit 1
    fi
  else
    # Resolve WINE-BLEEDING alias
    dist_path="$(wb_dist_resolve_alias)"
    if [[ -z "${dist_path}" || ! -d "${dist_path}" ]]; then
      echo "wb run: WINE-BLEEDING alias not set or missing; run 'wb runtime activate <NAME>'" >&2
      exit 1
    fi
  fi

  # Step 4: Resolve prefix
  local resolved_prefix_name
  if [[ -n "${prefix_name}" ]]; then
    resolved_prefix_name="${prefix_name}"
  elif [[ -n "${WB_PREFIX:-}" ]]; then
    resolved_prefix_name="${WB_PREFIX}"
  else
    resolved_prefix_name="DEFAULT"
  fi

  local prefix_path
  prefix_path="$(wb_prefix_resolve "${resolved_prefix_name}")"

  # Load per-prefix wb.conf if it exists (config layer 4)
  local prefix_conf="${prefix_path}/wb.conf"
  if [[ -f "${prefix_conf}" ]]; then
    wb_config_load "${prefix_conf}"
  fi

  # Precondition check BEFORE lock acquisition so a failed run doesn't leave
  # an empty prefix directory on disk (wb_acquire_lock would mkdir -p).
  local prefix_class
  prefix_class="$(wb_prefix_classify "${prefix_path}")"

  if [[ "${prefix_class}" == "absent" ]]; then
    echo "wb run: prefix '${resolved_prefix_name}' does not exist (path: ${prefix_path})" >&2
    echo "wb run: run 'wb prefix init ${resolved_prefix_name}' first" >&2
    exit 1
  fi

  if [[ "${prefix_class}" == "broken" ]]; then
    echo "wb run: prefix '${resolved_prefix_name}' is classified as broken (path: ${prefix_path})" >&2
    echo "wb run: run 'wb prefix init ${resolved_prefix_name}' to re-initialize" >&2
    exit 1
  fi

  if [[ "${prefix_class}" == "pp-owned-untouched" ]]; then
    echo "wb run: prefix '${resolved_prefix_name}' is PortProton-owned and has not been adopted" >&2
    echo "wb run: run 'wb prefix adopt ${prefix_path}' first (coexist mode leaves PP state intact)" >&2
    exit 1
  fi

  # Step 5: Acquire lock (released explicitly before exec; trap handles non-exec exits)
  if ! wb_acquire_lock "${prefix_path}"; then
    echo "wb run: could not acquire lock on ${prefix_path}" >&2
    exit 1
  fi

  # Trap to release lock on non-exec exit paths
  trap 'wb_release_lock "${prefix_path}" 2>/dev/null || true' EXIT

  # SECURITY: pin the hooks directory at entry so subsequent hook phases cannot
  # be redirected by an earlier hook that exports WB_HOME to a rogue path.
  _WB_HOOKS_DIR_PIN="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}/plugins/hooks.d"
  export _WB_HOOKS_DIR_PIN

  # Step 6: pre-reconcile hook
  if ! wb_hooks_run "pre-reconcile"; then
    echo "wb run: pre-reconcile hook failed; aborting" >&2
    exit 1
  fi

  # M9: Multi-build runtime switch (BEFORE component reconcile).
  # Only fires when multi-build is enabled AND --runtime was explicitly requested.
  if wb_multibuild_enabled && [[ -n "${runtime_name}" ]]; then
    # Scope the consent flag to just this call — do NOT leak WB_YES_WINEBOOT
    # into the wine child's environment (L4 fix).
    local switch_rc=0
    if [[ "${yes_wineboot}" -eq 1 ]]; then
      WB_YES_WINEBOOT=1 wb_multibuild_reconcile_switch "${prefix_path}" "${dist_path}" || switch_rc=$?
    else
      wb_multibuild_reconcile_switch "${prefix_path}" "${dist_path}" || switch_rc=$?
    fi
    if [[ "${switch_rc}" -eq 42 ]]; then
      echo "wb run: re-run with --yes-wineboot to consent to wineboot, or set WB_AUTO_WINEBOOT_ON_MAJOR_CHANGE=1" >&2
      exit 42
    elif [[ "${switch_rc}" -ne 0 ]]; then
      echo "wb run: multi-build runtime switch failed (exit ${switch_rc})" >&2
      exit 1
    fi
  fi

  # Step 8: pre-materialize hook → reconcile if needed → post-materialize hook
  if ! wb_hooks_run "pre-materialize"; then
    echo "wb run: pre-materialize hook failed; aborting" >&2
    exit 1
  fi

  # Cheap idempotent reconcile check: if .wb_components is drifted, re-deploy.
  local drift_output
  drift_output="$(wb_components_diff "${prefix_path}")"
  if [[ -n "${drift_output}" ]]; then
    wb_log_info "wb run: components drifted (${drift_output}); reconciling..."
    wb_prefix_reconcile "${prefix_path}"
  fi

  if ! wb_hooks_run "post-materialize"; then
    echo "wb run: post-materialize hook failed; aborting" >&2
    exit 1
  fi

  # Step 9: pre-exec hook — failure aborts launch
  if ! wb_hooks_run "pre-exec"; then
    echo "wb run: pre-exec hook failed; aborting launch" >&2
    exit 1
  fi

  # Step 10: Compose environment
  local env_lines
  env_lines="$(wb_env_compose "${prefix_path}" "${dist_path}")"

  # Build env KEY=VALUE array for exec env
  local -a env_pairs=()
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    env_pairs+=("${line}")
  done <<< "${env_lines}"

  # Extract WINELOADER from composed env for the exec call
  local wineloader="${dist_path}/bin/wine"
  local ev
  for ev in "${env_pairs[@]}"; do
    if [[ "${ev}" == WINELOADER=* ]]; then
      wineloader="${ev#WINELOADER=}"
      break
    fi
  done

  # Step 11: Release lock BEFORE exec (M5-R3).
  # The exec'd Wine process doesn't need our flock; releasing here ensures
  # that the trap (which fires on exec-replace too) doesn't double-release.
  wb_release_lock "${prefix_path}" 2>/dev/null || true
  trap - EXIT

  # M11: pressure-vessel / SLR container wrapping.
  # When WB_CONTAINER=1, wrap the wine invocation inside the SLR entry-point.
  # The container wrapping replaces the direct exec with a pressure-vessel exec.
  if wb_container_enabled; then
    local pv_entry
    if ! pv_entry="$(wb_container_detect)"; then
      echo "wb run: pressure-vessel not found; install Steam Linux Runtime via Steam" >&2
      echo "wb run: (Tools > Steam Linux Runtime - Sniper) or set \$WB_CONTAINER_ENTRY" >&2
      exit 1
    fi

    # Build the full argv: <entry> --filesystem=<prefix> --verb=waitforexitandrun -- <wineloader> <exe> [args...]
    local -a pv_argv=()
    while IFS= read -r REPLY; do
      pv_argv+=("${REPLY}")
    done < <(wb_container_compose_argv "${pv_entry}" "${prefix_path}" "${dist_path}" "${wineloader}" "${exe}" "${extra_args[@]+"${extra_args[@]}"}")

    # Step 12 / 13 (container path): exec (or fork+wait)
    if [[ "${do_wait}" -eq 1 ]]; then
      local child_pid child_exit
      (
        exec env "${env_pairs[@]}" "${pv_argv[@]}"
      ) &
      child_pid=$!
      wait "${child_pid}" && child_exit=0 || child_exit=$?
      export WB_EXIT="${child_exit}"
      wb_hooks_run "post-exec" || true
      exit "${child_exit}"
    else
      exec env "${env_pairs[@]}" "${pv_argv[@]}"
    fi
  fi

  # Step 12 / 13: exec (or fork+wait if --wait was passed)
  if [[ "${do_wait}" -eq 1 ]]; then
    # Fork-and-wait: run Wine in a child process, capture exit, run post-exec hook.
    local child_pid child_exit
    (
      exec env "${env_pairs[@]}" "${wineloader}" "${exe}" "${extra_args[@]+"${extra_args[@]}"}"
    ) &
    child_pid=$!
    wait "${child_pid}" && child_exit=0 || child_exit=$?
    export WB_EXIT="${child_exit}"
    wb_hooks_run "post-exec" || true
    exit "${child_exit}"
  else
    # Direct exec: replaces this shell with Wine. No post-exec hook fires.
    exec env "${env_pairs[@]}" "${wineloader}" "${exe}" "${extra_args[@]+"${extra_args[@]}"}"
  fi
}

# ---------------------------------------------------------------------------
# cmd_exec: wb exec <exe> [args...]
# Skips reconcile entirely (debugging only). Loads config, resolves
# runtime/prefix, composes env, execs wine. No hooks run.
# ---------------------------------------------------------------------------
cmd_exec() {
  local exe=""
  local -a extra_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        shift
        break
        ;;
      -*)
        echo "wb exec: unknown option '$1'" >&2
        exit 1
        ;;
      *)
        if [[ -z "${exe}" ]]; then
          exe="$1"
        else
          extra_args+=("$1")
        fi
        shift
        ;;
    esac
  done
  # remaining args after --
  while [[ $# -gt 0 ]]; do
    extra_args+=("$1")
    shift
  done

  if [[ -z "${exe}" ]]; then
    echo "wb exec: <exe> required" >&2
    exit 1
  fi

  _wb_load_run_lib

  _wb_validate_path_arg "exec" "${exe}"

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
  wb_config_load

  # Resolve runtime
  local dist_path
  if [[ -n "${WB_RUNTIME:-}" && "${WB_RUNTIME}" != "WINE-BLEEDING" ]]; then
    dist_path="${wb_home}/dist/${WB_RUNTIME}"
  else
    dist_path="$(wb_dist_resolve_alias)"
  fi

  if [[ -z "${dist_path}" || ! -d "${dist_path}" ]]; then
    echo "wb exec: WINE-BLEEDING alias not set or missing; run 'wb runtime activate <NAME>'" >&2
    exit 1
  fi

  # Resolve prefix
  local resolved_prefix_name="${WB_PREFIX:-DEFAULT}"
  local prefix_path
  prefix_path="$(wb_prefix_resolve "${resolved_prefix_name}")"

  wb_log_warn "wb exec: reconcile skipped (debugging only)"

  local env_lines
  env_lines="$(wb_env_compose "${prefix_path}" "${dist_path}")"

  local -a env_pairs=()
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    env_pairs+=("${line}")
  done <<< "${env_lines}"

  local wineloader="${dist_path}/bin/wine"
  local ev
  for ev in "${env_pairs[@]}"; do
    if [[ "${ev}" == WINELOADER=* ]]; then
      wineloader="${ev#WINELOADER=}"
      break
    fi
  done

  # M11: honor WB_CONTAINER in exec path as well
  if wb_container_enabled; then
    local pv_entry
    if ! pv_entry="$(wb_container_detect)"; then
      echo "wb exec: pressure-vessel not found; install Steam Linux Runtime via Steam" >&2
      echo "wb exec: (Tools > Steam Linux Runtime - Sniper) or set \$WB_CONTAINER_ENTRY" >&2
      exit 1
    fi
    local -a pv_argv=()
    while IFS= read -r REPLY; do
      pv_argv+=("${REPLY}")
    done < <(wb_container_compose_argv "${pv_entry}" "${prefix_path}" "${dist_path}" "${wineloader}" "${exe}" "${extra_args[@]+"${extra_args[@]}"}")
    exec env "${env_pairs[@]}" "${pv_argv[@]}"
  fi

  exec env "${env_pairs[@]}" "${wineloader}" "${exe}" "${extra_args[@]+"${extra_args[@]}"}"
}

cmd_log_tail() {
  local n="${1:-50}"
  [[ "${n}" =~ ^[0-9]+$ ]] || n=50
  _wb_load_libs
  local log_file
  log_file="${WB_LOG_FILE:-$(wb_home)/log/wb.log}"
  if [[ ! -f "${log_file}" ]]; then
    exit 0
  fi
  tail -n "${n}" "${log_file}"
}

main() {
  local subcommand="${1:-}"

  case "${subcommand}" in
    --version)
      cmd_version
      ;;
    help)
      cmd_help
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    exec)
      shift
      cmd_exec "$@"
      ;;
    config)
      local action="${2:-}"
      case "${action}" in
        show)
          cmd_config_show
          ;;
        path)
          cmd_config_path "${3:-}"
          ;;
        enable-multibuild)
          cmd_config_enable_multibuild
          ;;
        disable-multibuild)
          cmd_config_disable_multibuild
          ;;
        enable-container)
          cmd_config_enable_container
          ;;
        disable-container)
          cmd_config_disable_container
          ;;
        *)
          echo "wb config: unknown action '${action}'" >&2
          echo "Valid actions: show, path, enable-multibuild, disable-multibuild, enable-container, disable-container" >&2
          exit 1
          ;;
      esac
      ;;
    log)
      local action="${2:-}"
      case "${action}" in
        tail)
          cmd_log_tail "${3:-50}"
          ;;
        *)
          echo "wb log: unknown action '${action}'" >&2
          echo "Valid actions: tail" >&2
          exit 1
          ;;
      esac
      ;;
    runtime)
      local action="${2:-}"
      case "${action}" in
        list)
          shift 2
          cmd_runtime_list "$@"
          ;;
        info)
          cmd_runtime_info "${3:-}"
          ;;
        install)
          shift 2
          cmd_runtime_install "$@"
          ;;
        activate)
          cmd_runtime_activate "${3:-}"
          ;;
        prune)
          shift 2
          cmd_runtime_prune "$@"
          ;;
        register)
          cmd_runtime_register "${3:-}"
          ;;
        unregister)
          cmd_runtime_unregister "${3:-}"
          ;;
        *)
          echo "wb runtime: unknown action '${action}'" >&2
          echo "Valid actions: list, info, install, activate, prune, register, unregister" >&2
          exit 1
          ;;
      esac
      ;;
    prefix)
      local action="${2:-}"
      case "${action}" in
        list)
          cmd_prefix_list
          ;;
        info)
          cmd_prefix_info "${3:-}"
          ;;
        adopt)
          shift 2
          cmd_prefix_adopt "$@"
          ;;
        import)
          cmd_prefix_import "${3:-}"
          ;;
        init)
          shift 2
          cmd_prefix_init "$@"
          ;;
        components)
          cmd_prefix_components "${3:-}"
          ;;
        reconcile)
          cmd_prefix_reconcile "${3:-}"
          ;;
        history)
          cmd_prefix_history "${3:-}"
          ;;
        snapshot)
          cmd_prefix_snapshot "${3:-}"
          ;;
        snapshots)
          cmd_prefix_snapshots "${3:-}"
          ;;
        repair)
          shift 2
          cmd_prefix_repair "$@"
          ;;
        migrate)
          shift 2
          cmd_prefix_migrate "$@"
          ;;
        export)
          shift 2
          cmd_prefix_export "$@"
          ;;
        *)
          echo "wb prefix: unknown action '${action}'" >&2
          echo "Valid actions: list, info, adopt, import, init, components, reconcile, history, snapshot, snapshots, repair, migrate, export" >&2
          exit 1
          ;;
      esac
      ;;
    install)
      shift
      cmd_install "$@"
      ;;
    pp)
      local action="${2:-}"
      case "${action}" in
        install)
          cmd_pp_install
          ;;
        uninstall)
          cmd_pp_uninstall
          ;;
        status)
          cmd_pp_status
          ;;
        *)
          echo "wb pp: unknown action '${action}'" >&2
          echo "Valid actions: install, uninstall, status" >&2
          exit 1
          ;;
      esac
      ;;
    import-ppdb)
      shift
      cmd_import_ppdb "$@"
      ;;
    "")
      usage
      exit 1
      ;;
    *)
      echo "wb: unknown subcommand '${subcommand}'" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"