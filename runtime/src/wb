# ---------------------------------------------------------------------------
# cmd_config_enable_multibuild / cmd_config_disable_multibuild
# Writes/updates WB_MULTIBUILD in $WB_HOME/etc/runtime.conf.
# ---------------------------------------------------------------------------
_wb_conf_set_key() {
  local conf_file="$1"
  local key="$2"
  local value="$3"

  mkdir -p "$(dirname "${conf_file}")"

  if [[ ! -f "${conf_file}" ]]; then
    printf '%s=%s\n' "${key}" "${value}" > "${conf_file}"
    return 0
  fi

  # Update if key exists, else append
  if grep -qP "^${key}=" "${conf_file}" 2>/dev/null; then
    # Use a temp file to avoid in-place sed portability issues
    local tmp
    tmp="$(mktemp "$(dirname "${conf_file}")/.wb_conf_XXXXXX")"
    grep -vP "^${key}=" "${conf_file}" > "${tmp}" || true
    printf '%s=%s\n' "${key}" "${value}" >> "${tmp}"
    mv -T "${tmp}" "${conf_file}"
  else
    printf '%s=%s\n' "${key}" "${value}" >> "${conf_file}"
  fi
}

_wb_conf_unset_key() {
  local conf_file="$1"
  local key="$2"

  [[ -f "${conf_file}" ]] || return 0

  local tmp
  tmp="$(mktemp "$(dirname "${conf_file}")/.wb_conf_XXXXXX")"
  grep -vP "^${key}=" "${conf_file}" > "${tmp}" || true
  mv -T "${tmp}" "${conf_file}"
}

cmd_config_enable_multibuild() {
  _wb_load_libs
  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
