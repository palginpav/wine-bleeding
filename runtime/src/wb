#!/usr/bin/env bash
set -euo pipefail

WB_VERSION="0.1.0-M4"

_WB_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/wb-lib" && pwd)"

_wb_load_libs() {
  # shellcheck source=wb-lib/wb-paths.sh
  source "${_WB_LIB_DIR}/wb-paths.sh"
  # shellcheck source=wb-lib/wb-log.sh
  source "${_WB_LIB_DIR}/wb-log.sh"
  # shellcheck source=wb-lib/wb-json.sh
  source "${_WB_LIB_DIR}/wb-json.sh"
  # shellcheck source=wb-lib/wb-config.sh
  source "${_WB_LIB_DIR}/wb-config.sh"
  # shellcheck source=wb-lib/wb-lock.sh
  source "${_WB_LIB_DIR}/wb-lock.sh"
}

_wb_load_dist_lib() {
  _wb_load_libs
  # shellcheck source=wb-lib/wb-dist.sh
  source "${_WB_LIB_DIR}/wb-dist.sh"
}

_wb_load_prefix_lib() {
  _wb_load_dist_lib
  # shellcheck source=wb-lib/wb-prefix.sh
  source "${_WB_LIB_DIR}/wb-prefix.sh"
}

_wb_load_wineboot_lib() {
  _wb_load_prefix_lib
  # shellcheck source=wb-lib/wb-components.sh
  source "${_WB_LIB_DIR}/wb-components.sh"
  # shellcheck source=wb-lib/wb-reg.sh
  source "${_WB_LIB_DIR}/wb-reg.sh"
  # shellcheck source=wb-lib/wb-wineboot.sh
  source "${_WB_LIB_DIR}/wb-wineboot.sh"
}

_wb_load_ppdb_lib() {
  _wb_load_libs
  # shellcheck source=wb-lib/wb-ppdb.sh
  source "${_WB_LIB_DIR}/wb-ppdb.sh"
}

usage() {
  echo "Usage: wb <subcommand> [args]  (run 'wb help' for more)" >&2
}

cmd_version() {
  echo "wb ${WB_VERSION}"
}

cmd_help() {
  cat <<EOF
wb ${WB_VERSION} -- wine-bleeding runtime dispatcher

Subcommands:
  config show               Print effective config as JSON (all 5 layers merged)
  config path [KEY]         Print which file supplied each config key (or only KEY)
  log tail [N]              Print last N JSON log entries (default 50)
  runtime list              List installed Wine dists (name, active, size, build date)
  runtime info <NAME>       Print .wb_dist_meta JSON for a dist
  runtime install <TARBALL> Extract tarball into dist/, write manifest
                            [--activate] also point WINE-BLEEDING alias at it
  runtime activate <NAME>   Re-point WINE-BLEEDING alias atomically
  runtime prune [--keep N]  Remove oldest dists beyond N most recent (default 3)
                            [--yes] skip confirmation prompt
  prefix list               List known prefixes with classification and last-adopted time
  prefix info <NAME>        Print classification and .wb_runtime JSON for a prefix
  prefix adopt <PATH>       Adopt an existing (PP) prefix in coexist mode
                            [--take-over] claim full ownership (rewrites .wine_ver)
  prefix import <PATH>      Adopt a prefix and symlink it into WB_HOME/prefixes/
  prefix init [NAME]        Create and initialise a new Wine prefix
                            [--runtime NAME] use dist by alias name
                            [--dist PATH]    use dist by absolute path
  prefix components [NAME]  Print .wb_components JSON for a prefix
  prefix reconcile [NAME]   Re-deploy components idempotently (no wineboot)
  import-ppdb <INPUT> [OUT] Convert a legacy bash .ppdb to JSON .wb.ppdb
                            OUT defaults to INPUT.wb.ppdb
  help                      Show this help
  --version                 Print version string

Future commands: run
EOF
}

cmd_config_show() {
  _wb_load_libs
  wb_config_load
  wb_config_as_json
}

cmd_config_path() {
  local key="${1:-}"
  _wb_load_libs
  wb_config_load
  wb_config_path_for "${key}"
}

cmd_runtime_list() {
  _wb_load_dist_lib
  local dist_dir
  dist_dir="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}/dist"
  local alias_target
  alias_target="$(wb_dist_resolve_alias)"

  printf '%-28s %-6s %-8s %s\n' "NAME" "ACTIVE" "SIZE" "BUILD_DATE"
  local name entry active size build_date
  while IFS= read -r name; do
    entry="${dist_dir}/${name}"
    if [[ "${entry}" == "${alias_target}" ]]; then
      active="y"
    else
      active="n"
    fi
    size="$(timeout 3 du -sh "${entry}" 2>/dev/null | awk '{print $1}' || echo "?")"
    build_date="$(wb_dist_meta_read "${entry}" '.build_utc' 2>/dev/null || true)"
    if [[ -z "${build_date}" ]]; then
      build_date="$(stat -c '%y' "${entry}" 2>/dev/null | cut -d' ' -f1 || echo "?")"
    fi
    printf '%-28s %-6s %-8s %s\n' "${name}" "${active}" "${size}" "${build_date}"
  done < <(wb_dist_list)
}

cmd_runtime_info() {
  local name="${1:-}"
  if [[ -z "${name}" ]]; then
    echo "wb runtime info: NAME required" >&2
    exit 1
  fi
  if ! [[ "${name}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "wb runtime info: invalid NAME '${name}' (expected [A-Za-z0-9_.-]+)" >&2
    exit 1
  fi
  _wb_load_dist_lib
  local dist_dir
  dist_dir="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}/dist"
  local dist_path="${dist_dir}/${name}"
  if [[ ! -d "${dist_path}" ]]; then
    echo "wb runtime info: dist '${name}' not found in ${dist_dir}" >&2
    exit 1
  fi
  if [[ ! -f "${dist_path}/.wb_dist_meta" ]]; then
    echo "wb runtime info: no .wb_dist_meta in '${name}'" >&2
    exit 1
  fi
  jq . "${dist_path}/.wb_dist_meta"
}

cmd_runtime_install() {
  local tarball="" activate=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --activate) activate=1 ;;
      *) tarball="$1" ;;
    esac
    shift
  done

  if [[ -z "${tarball}" ]]; then
    echo "wb runtime install: TARBALL required" >&2
    exit 1
  fi
  if [[ ! -f "${tarball}" ]]; then
    echo "wb runtime install: tarball not found: ${tarball}" >&2
    exit 1
  fi

  _wb_load_dist_lib

  # SECURITY: validate tarball entries before extraction
  local entry
  while IFS= read -r entry; do
    # Reject absolute paths
    if [[ "${entry}" == /* ]]; then
      echo "wb runtime install: REJECTED — tarball contains absolute path: ${entry}" >&2
      exit 1
    fi
    # Reject path traversal via ..
    if [[ "${entry}" == *..* ]]; then
      echo "wb runtime install: REJECTED — tarball contains path traversal: ${entry}" >&2
      exit 1
    fi
  done < <(tar -tf "${tarball}" 2>/dev/null)

  # SECURITY: validate absolute AND relative-escape symlinks inside the tarball.
  # Relative targets containing `..` can still escape the dist root after extraction.
  local link_entry link_target
  while IFS= read -r link_entry; do
    link_target="${link_entry##* -> }"
    if [[ "${link_target}" == /* ]]; then
      echo "wb runtime install: REJECTED — tarball contains absolute symlink: ${link_target}" >&2
      exit 1
    fi
    if [[ "${link_target}" == *..* ]]; then
      echo "wb runtime install: REJECTED — tarball contains escape symlink (..): ${link_target}" >&2
      exit 1
    fi
  done < <(tar -tvf "${tarball}" 2>/dev/null | grep '^l')

  # SECURITY: reject non-regular entries (FIFO, device, socket).
  local type_line type_char
  while IFS= read -r type_line; do
    type_char="${type_line:0:1}"
    case "${type_char}" in
      -|d|l) : ;;  # regular, directory, symlink OK
      *)
        echo "wb runtime install: REJECTED — tarball contains non-regular entry (${type_char}): ${type_line}" >&2
        exit 1
        ;;
    esac
  done < <(tar -tvf "${tarball}" 2>/dev/null)

  # Validate single top-level directory matching WINE-BLEEDING-*
  local top_dirs
  top_dirs="$(tar -tf "${tarball}" 2>/dev/null \
    | grep -oP '^[^/]+/' \
    | sort -u || true)"
  local top_count
  top_count="$(echo "${top_dirs}" | grep -c . || true)"
  if [[ "${top_count}" -ne 1 ]]; then
    echo "wb runtime install: REJECTED — tarball must contain exactly one top-level directory, found: ${top_dirs}" >&2
    exit 1
  fi
  local top_dir
  top_dir="$(echo "${top_dirs}" | tr -d '/')"
  if [[ "${top_dir}" != WINE-BLEEDING-* ]]; then
    echo "wb runtime install: REJECTED — top-level directory must be named WINE-BLEEDING-*, got: ${top_dir}" >&2
    exit 1
  fi

  local dist_dir
  dist_dir="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}/dist"
  mkdir -p "${dist_dir}"

  local dist_path="${dist_dir}/${top_dir}"
  # Clean up partial extraction if install fails partway (H1/M1).
  trap 'rm -rf "${dist_path}"' ERR

  wb_log_info "Installing ${tarball} into ${dist_dir}"
  tar --no-same-owner --no-same-permissions -xf "${tarball}" -C "${dist_dir}"

  wb_dist_meta_write "${dist_path}"
  wb_log_info "Wrote .wb_dist_meta for ${top_dir}"
  trap - ERR

  if [[ "${activate}" -eq 1 ]]; then
    wb_dist_set_alias "${dist_path}"
    wb_log_info "Activated ${top_dir} as WINE-BLEEDING alias"
  fi

  echo "Installed: ${top_dir}"
}

cmd_runtime_activate() {
  local name="${1:-}"
  if [[ -z "${name}" ]]; then
    echo "wb runtime activate: NAME required" >&2
    exit 1
  fi
  if ! [[ "${name}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "wb runtime activate: invalid NAME '${name}' (expected [A-Za-z0-9_.-]+)" >&2
    exit 1
  fi
  _wb_load_dist_lib
  local dist_dir
  dist_dir="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}/dist"
  local dist_path="${dist_dir}/${name}"
  if [[ ! -d "${dist_path}" ]]; then
    echo "wb runtime activate: dist '${name}' not found in ${dist_dir}" >&2
    exit 1
  fi
  wb_dist_set_alias "${dist_path}"
  wb_log_info "Activated ${name} as WINE-BLEEDING alias"
  echo "Activated: ${name}"
}

cmd_runtime_prune() {
  local keep=3 yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep)
        keep="${2:-3}"
        shift
        ;;
      --keep=*)
        keep="${1#--keep=}"
        ;;
      --yes)
        yes=1
        ;;
    esac
    shift
  done

  if ! [[ "${keep}" =~ ^[0-9]+$ ]]; then
    echo "wb runtime prune: --keep must be a non-negative integer, got '${keep}'" >&2
    exit 1
  fi

  _wb_load_dist_lib
  local dist_dir
  dist_dir="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}/dist"

  local alias_target
  alias_target="$(wb_dist_resolve_alias)"

  # Build sorted list: newest first, by build_utc then fallback mtime
  local -a all_dists=()
  local name entry
  while IFS= read -r name; do
    entry="${dist_dir}/${name}"
    local ts
    ts="$(wb_dist_meta_read "${entry}" '.build_utc' 2>/dev/null || true)"
    if [[ -z "${ts}" ]]; then
      ts="$(stat -c '%Y' "${entry}" 2>/dev/null || echo "0")"
    fi
    all_dists+=("${ts}|${name}")
  done < <(wb_dist_list)

  # Sort descending by timestamp (newest first)
  local -a sorted_dists=()
  while IFS= read -r line; do
    sorted_dists+=("${line}")
  done < <(printf '%s\n' "${all_dists[@]}" | sort -t'|' -k1 -r)

  local total="${#sorted_dists[@]}"
  if [[ "${total}" -le "${keep}" ]]; then
    echo "Nothing to prune: ${total} dist(s) present, keeping ${keep}"
    return 0
  fi

  # Collect candidates to delete (everything beyond keep-th)
  local -a to_delete=()
  local i
  for (( i=keep; i<total; i++ )); do
    local pair="${sorted_dists[${i}]}"
    name="${pair#*|}"
    entry="${dist_dir}/${name}"
    # NEVER delete the alias target
    if [[ "${entry}" == "${alias_target}" ]]; then
      echo "Skipping alias target: ${name}"
      continue
    fi
    to_delete+=("${name}")
  done

  if [[ "${#to_delete[@]}" -eq 0 ]]; then
    echo "Nothing to prune."
    return 0
  fi

  echo "Will delete:"
  local d
  for d in "${to_delete[@]}"; do
    echo "  ${d}"
  done

  if [[ "${yes}" -ne 1 ]]; then
    printf 'Proceed? [y/N] '
    local answer
    read -r answer
    if [[ "${answer}" != "y" && "${answer}" != "Y" ]]; then
      echo "Aborted."
      return 0
    fi
  fi

  for d in "${to_delete[@]}"; do
    wb_log_info "Pruning ${d}"
    rm -rf "${dist_dir:?}/${d}"
    echo "Deleted: ${d}"
  done
}

_wb_validate_path_arg() {
  local context="$1"
  local val="$2"
  if [[ -z "${val}" ]]; then
    echo "wb ${context}: PATH/NAME required" >&2
    exit 1
  fi
  # SECURITY: reject path traversal
  if [[ "${val}" == *..* ]]; then
    echo "wb ${context}: invalid PATH/NAME '${val}' (path traversal via '..' rejected)" >&2
    exit 1
  fi
  # Absolute paths allow `/`; relative names do not (prefixes are one segment).
  if [[ "${val}" == /* ]]; then
    if ! [[ "${val}" =~ ^/[A-Za-z0-9_./-]+$ ]]; then
      echo "wb ${context}: invalid PATH '${val}' (expected [A-Za-z0-9_./-]+)" >&2
      exit 1
    fi
  else
    if ! [[ "${val}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
      echo "wb ${context}: invalid NAME '${val}' (expected [A-Za-z0-9_.-]+ with no slashes)" >&2
      exit 1
    fi
  fi
}

cmd_prefix_list() {
  _wb_load_prefix_lib
  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
  printf '%-28s %-20s %s\n' "NAME" "CLASSIFICATION" "LAST_ADOPTED_UTC"
  local name
  while IFS= read -r name; do
    local ppath="${wb_home}/prefixes/${name}"
    local class last_adopted
    class="$(wb_prefix_classify "${ppath}")"
    local sentinel="${ppath}/.wb_runtime"
    if [[ -f "${sentinel}" ]] && jq empty "${sentinel}" 2>/dev/null; then
      last_adopted="$(jq -r '.last_adopted_utc // empty' "${sentinel}" 2>/dev/null || true)"
    else
      last_adopted=""
    fi
    [[ -z "${last_adopted}" ]] && last_adopted="-"
    printf '%-28s %-20s %s\n' "${name}" "${class}" "${last_adopted}"
  done < <(wb_prefix_list)
}

cmd_prefix_info() {
  local name="${1:-}"
  _wb_validate_path_arg "prefix info" "${name}"
  _wb_load_prefix_lib

  local ppath
  if [[ "${name}" == /* ]]; then
    ppath="${name}"
  else
    local wb_home
    wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
    ppath="${wb_home}/prefixes/${name}"
  fi

  echo "Path: ${ppath}"

  local class
  class="$(wb_prefix_classify "${ppath}")"
  echo "Classification: ${class}"

  local sentinel="${ppath}/.wb_runtime"
  if [[ ! -f "${sentinel}" ]]; then
    echo "(no sentinel)"
    return 0
  fi

  # SECURITY: hold a shared lock across the sentinel read so a concurrent
  # writer cannot produce a torn view. Shared (-s) permits parallel readers.
  local lockfile="${ppath}/.wb_lock"
  local deadline=$(( $(date +%s) + 5 ))
  local got_lock=0
  exec 9>"${lockfile}"
  while [[ "${got_lock}" -eq 0 ]]; do
    if flock -s -n 9 2>/dev/null; then
      got_lock=1
    else
      if [[ "$(date +%s)" -ge "${deadline}" ]]; then
        exec 9>&-
        echo "prefix busy" >&2
        exit 1
      fi
      sleep 0.5
    fi
  done

  if jq empty "${sentinel}" 2>/dev/null; then
    jq . "${sentinel}"
  else
    echo "(malformed sentinel)"
  fi
  exec 9>&-
}

cmd_prefix_adopt() {
  local path="${1:-}"
  _wb_validate_path_arg "prefix adopt" "${path}"
  shift || true

  _wb_load_prefix_lib

  local class_before
  class_before="$(wb_prefix_classify "${path}")"
  wb_log_info "prefix adopt: classification before: ${class_before}"
  echo "Classification before: ${class_before}"

  local take_over=0
  local extra_args=()
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --take-over)
        take_over=1
        extra_args+=("--take-over")
        ;;
      *)
        echo "wb prefix adopt: unknown option '${arg}'" >&2
        exit 1
        ;;
    esac
  done

  if [[ "${take_over}" -eq 1 ]]; then
    wb_log_info "prefix adopt: take-over mode selected"
  else
    wb_log_info "prefix adopt: coexist mode (default)"
  fi

  wb_prefix_adopt "${path}" "${extra_args[@]+"${extra_args[@]}"}"

  local class_after
  class_after="$(wb_prefix_classify "${path}")"
  wb_log_info "prefix adopt: classification after: ${class_after}"
  echo "Classification after: ${class_after}"
}

cmd_prefix_import() {
  local path="${1:-}"
  _wb_validate_path_arg "prefix import" "${path}"
  _wb_load_prefix_lib

  if [[ ! -d "${path}" ]]; then
    echo "wb prefix import: path '${path}' does not exist or is not a directory" >&2
    exit 1
  fi

  local basename
  basename="$(basename "${path}")"
  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"
  local link_target="${wb_home}/prefixes/${basename}"

  local resolved_path
  resolved_path="$(readlink -f "${path}")"

  # Collision check BEFORE adopt so we don't orphan .wb_runtime on conflict.
  if [[ -L "${link_target}" ]]; then
    local existing_target
    existing_target="$(readlink -f "${link_target}" 2>/dev/null || true)"
    if [[ "${existing_target}" != "${resolved_path}" ]]; then
      echo "wb prefix import: symlink '${link_target}' already exists and points elsewhere (${existing_target})" >&2
      exit 1
    fi
  elif [[ -e "${link_target}" ]]; then
    echo "wb prefix import: '${link_target}' already exists and is not a symlink" >&2
    exit 1
  fi

  # Coexist adopt
  wb_prefix_adopt "${path}"

  mkdir -p "${wb_home}/prefixes"

  if [[ -L "${link_target}" ]]; then
    # Collision already checked above; existing symlink points at the same target.
    echo "imported as ${basename} (symlink already exists, no-op)"
    return 0
  elif [[ -e "${link_target}" ]]; then
    echo "wb prefix import: '${link_target}' already exists and is not a symlink" >&2
    exit 1
  fi

  ln -s "${resolved_path}" "${link_target}"
  echo "imported as ${basename}"
}

cmd_prefix_init() {
  local prefix_name="" dist_path="" runtime_name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --runtime)
        runtime_name="${2:-}"
        shift 2
        ;;
      --runtime=*)
        runtime_name="${1#--runtime=}"
        shift
        ;;
      --dist)
        dist_path="${2:-}"
        shift 2
        ;;
      --dist=*)
        dist_path="${1#--dist=}"
        shift
        ;;
      *)
        prefix_name="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${prefix_name}" ]]; then
    prefix_name="${WB_PREFIX:-}"
  fi
  if [[ -z "${prefix_name}" ]]; then
    echo "wb prefix init: NAME required (or set WB_PREFIX)" >&2
    exit 1
  fi

  _wb_validate_path_arg "prefix init" "${prefix_name}"
  if [[ -n "${dist_path}" ]]; then
    _wb_validate_path_arg "prefix init --dist" "${dist_path}"
  fi
  if [[ -n "${runtime_name}" ]]; then
    _wb_validate_path_arg "prefix init --runtime" "${runtime_name}"
  fi

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"

  if [[ -z "${dist_path}" ]]; then
    if [[ -n "${runtime_name}" ]]; then
      _wb_validate_path_arg "prefix init --runtime" "${runtime_name}"
      dist_path="${wb_home}/dist/${runtime_name}"
    else
      dist_path="${wb_home}/dist/WINE-BLEEDING"
    fi
  fi

  _wb_load_wineboot_lib

  local prefix_path
  if [[ "${prefix_name}" == /* ]]; then
    prefix_path="${prefix_name}"
  else
    prefix_path="${wb_home}/prefixes/${prefix_name}"
  fi

  mkdir -p "${wb_home}/prefixes"
  wb_prefix_init "${prefix_path}" "${dist_path}"
  echo "initialized: ${prefix_path}"
}

cmd_prefix_components() {
  local prefix_name="${1:-}"
  if [[ -z "${prefix_name}" ]]; then
    prefix_name="${WB_PREFIX:-}"
  fi
  if [[ -z "${prefix_name}" ]]; then
    echo "wb prefix components: NAME required" >&2
    exit 1
  fi

  _wb_validate_path_arg "prefix components" "${prefix_name}"
  _wb_load_prefix_lib

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"

  local prefix_path
  if [[ "${prefix_name}" == /* ]]; then
    prefix_path="${prefix_name}"
  else
    prefix_path="${wb_home}/prefixes/${prefix_name}"
  fi

  local manifest="${prefix_path}/.wb_components"
  if [[ ! -f "${manifest}" ]]; then
    echo "wb prefix components: no .wb_components at ${prefix_path}" >&2
    exit 1
  fi

  if ! jq . "${manifest}"; then
    echo "wb prefix components: malformed .wb_components JSON" >&2
    exit 1
  fi
}

cmd_prefix_reconcile() {
  local prefix_name="${1:-}"
  if [[ -z "${prefix_name}" ]]; then
    prefix_name="${WB_PREFIX:-}"
  fi
  if [[ -z "${prefix_name}" ]]; then
    echo "wb prefix reconcile: NAME required" >&2
    exit 1
  fi

  _wb_validate_path_arg "prefix reconcile" "${prefix_name}"
  _wb_load_wineboot_lib

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"

  local prefix_path
  if [[ "${prefix_name}" == /* ]]; then
    prefix_path="${prefix_name}"
  else
    prefix_path="${wb_home}/prefixes/${prefix_name}"
  fi

  local before_manifest="${prefix_path}/.wb_components"
  local before_hash=""
  if [[ -f "${before_manifest}" ]]; then
    before_hash="$(jq -r '.deployed_utc // ""' "${before_manifest}" 2>/dev/null || true)"
  fi

  wb_prefix_reconcile "${prefix_path}"

  local after_hash=""
  if [[ -f "${before_manifest}" ]]; then
    after_hash="$(jq -r '.deployed_utc // ""' "${before_manifest}" 2>/dev/null || true)"
  fi

  if [[ "${before_hash}" != "${after_hash}" ]]; then
    echo "reconciled: ${prefix_path} (components redeployed)"
  else
    echo "reconciled: ${prefix_path} (up to date)"
  fi
}

cmd_import_ppdb() {
  local input_path="${1:-}"
  local output_path="${2:-}"

  if [[ -z "${input_path}" ]]; then
    echo "wb import-ppdb: INPUT required" >&2
    exit 1
  fi

  if [[ -z "${output_path}" ]]; then
    output_path="${input_path}.wb.ppdb"
  fi

  _wb_load_ppdb_lib

  wb_ppdb_import_legacy "${input_path}" "${output_path}"
  echo "imported to: ${output_path}"
}

cmd_log_tail() {
  local n="${1:-50}"
  [[ "${n}" =~ ^[0-9]+$ ]] || n=50
  _wb_load_libs
  local log_file
  log_file="${WB_LOG_FILE:-$(wb_home)/log/wb.log}"
  if [[ ! -f "${log_file}" ]]; then
    exit 0
  fi
  tail -n "${n}" "${log_file}"
}

main() {
  local subcommand="${1:-}"

  case "${subcommand}" in
    --version)
      cmd_version
      ;;
    help)
      cmd_help
      ;;
    config)
      local action="${2:-}"
      case "${action}" in
        show)
          cmd_config_show
          ;;
        path)
          cmd_config_path "${3:-}"
          ;;
        *)
          echo "wb config: unknown action '${action}'" >&2
          echo "Valid actions: show, path" >&2
          exit 1
          ;;
      esac
      ;;
    log)
      local action="${2:-}"
      case "${action}" in
        tail)
          cmd_log_tail "${3:-50}"
          ;;
        *)
          echo "wb log: unknown action '${action}'" >&2
          echo "Valid actions: tail" >&2
          exit 1
          ;;
      esac
      ;;
    runtime)
      local action="${2:-}"
      case "${action}" in
        list)
          cmd_runtime_list
          ;;
        info)
          cmd_runtime_info "${3:-}"
          ;;
        install)
          shift 2
          cmd_runtime_install "$@"
          ;;
        activate)
          cmd_runtime_activate "${3:-}"
          ;;
        prune)
          shift 2
          cmd_runtime_prune "$@"
          ;;
        *)
          echo "wb runtime: unknown action '${action}'" >&2
          echo "Valid actions: list, info, install, activate, prune" >&2
          exit 1
          ;;
      esac
      ;;
    prefix)
      local action="${2:-}"
      case "${action}" in
        list)
          cmd_prefix_list
          ;;
        info)
          cmd_prefix_info "${3:-}"
          ;;
        adopt)
          shift 2
          cmd_prefix_adopt "$@"
          ;;
        import)
          cmd_prefix_import "${3:-}"
          ;;
        init)
          shift 2
          cmd_prefix_init "$@"
          ;;
        components)
          cmd_prefix_components "${3:-}"
          ;;
        reconcile)
          cmd_prefix_reconcile "${3:-}"
          ;;
        *)
          echo "wb prefix: unknown action '${action}'" >&2
          echo "Valid actions: list, info, adopt, import, init, components, reconcile" >&2
          exit 1
          ;;
      esac
      ;;
    import-ppdb)
      shift
      cmd_import_ppdb "$@"
      ;;
    "")
      usage
      exit 1
      ;;
    *)
      echo "wb: unknown subcommand '${subcommand}'" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
