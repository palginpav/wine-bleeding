        ;;
      --runtime=*)
        runtime_name="${1#--runtime=}"
        shift
        ;;
      --dist)
        dist_path="${2:-}"
        shift 2
        ;;
      --dist=*)
        dist_path="${1#--dist=}"
        shift
        ;;
      *)
        prefix_name="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${prefix_name}" ]]; then
    prefix_name="${WB_PREFIX:-}"
  fi
  if [[ -z "${prefix_name}" ]]; then
    echo "wb prefix init: NAME required (or set WB_PREFIX)" >&2
    exit 1
  fi

  _wb_validate_path_arg "prefix init" "${prefix_name}"
  if [[ -n "${dist_path}" ]]; then
    _wb_validate_path_arg "prefix init --dist" "${dist_path}"
  fi
  if [[ -n "${runtime_name}" ]]; then
    _wb_validate_path_arg "prefix init --runtime" "${runtime_name}"
  fi

  local wb_home
  wb_home="${WB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-bleeding}"

  if [[ -z "${dist_path}" ]]; then
    if [[ -n "${runtime_name}" ]]; then
      _wb_validate_path_arg "prefix init --runtime" "${runtime_name}"
      dist_path="${wb_home}/dist/${runtime_name}"
    else
      dist_path="${wb_home}/dist/WINE-BLEEDING"
    fi
  fi

  _wb_load_wineboot_lib

  local prefix_path
  if [[ "${prefix_name}" == /* ]]; then
    prefix_path="${prefix_name}"
  else
    prefix_path="${wb_home}/prefixes/${prefix_name}"
  fi

  mkdir -p "${wb_home}/prefixes"
  wb_prefix_init "${prefix_path}" "${dist_path}"
  echo "initialized: ${prefix_path}"
}

