{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wine-bleeding/wb-runtime/schemas/wb_dist_meta.schema.json",
  "title": "wb_dist_meta",
  "description": "Manifest written into dist/WINE-BLEEDING-*/. wb_dist_meta by wb_dist_meta_write",
  "type": "object",
  "required": [
    "schema",
    "dist_name",
    "wine_major_version",
    "wine_full_version",
    "components",
    "builtin_dlls_hash",
    "build_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "dist_name": {
      "type": "string",
      "pattern": "^WINE-BLEEDING-[A-Za-z0-9._-]+$"
    },
    "wine_major_version": {
      "type": "string",
      "pattern": "^([0-9]+|unknown)$"
    },
    "wine_full_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]+$"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/component"
      },
      "properties": {
        "dxvk":  { "$ref": "#/$defs/component" },
        "vkd3d": { "$ref": "#/$defs/component" },
        "nvapi": { "$ref": "#/$defs/component" },
        "mono":  { "$ref": "#/$defs/component" },
        "icu":   { "$ref": "#/$defs/component" }
      }
    },
    "builtin_dlls_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$|^$"
    },
    "pp_supplied_mode": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "build_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "properties": {
        "version": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
            { "type": "null" }
          ]
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
