{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wine-bleeding/wb-runtime/schemas/wb_settings.schema.json",
  "title": "wb_settings",
  "description": "4-layer settings schemas for wb-gui (Phase A). Each $defs entry is the schema for one layer file.",
  "$comment": "Phase B/C/D add additional keys per roadmap decisions/phase-a-to-d-roadmap.md",
  "$defs": {

    "general": {
      "$comment": "Phase B/C/D add additional keys per roadmap decisions/phase-a-to-d-roadmap.md",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/wine-bleeding/wb-runtime/schemas/settings-general.schema.json",
      "title": "settings-general",
      "description": "Cross-cutting defaults — $WB_HOME/settings/general.json",
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "updated_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "gpu": {
          "oneOf": [
            { "type": "string", "enum": ["auto", "nvidia", "amd", "intel"] },
            { "type": "null" }
          ],
          "description": "Default GPU selection. null = use built-in default (auto)."
        },
        "win_version": {
          "oneOf": [
            { "type": "string", "enum": ["win10", "win11", "win8.1", "win8", "win7", "winxp", "vista"] },
            { "type": "null" }
          ],
          "description": "Default Windows version for winecfg. null = use built-in default (win10)."
        },
        "wine_debug": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "Default WINEDEBUG value. Empty string silences debug output. null = inherit."
        }
      }
    },

    "dist": {
      "$comment": "Phase B/C/D add additional keys per roadmap decisions/phase-a-to-d-roadmap.md",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/wine-bleeding/wb-runtime/schemas/settings-dist.schema.json",
      "title": "settings-dist",
      "description": "Per-dist settings — $WB_HOME/settings/dists/<dist-id>.json",
      "type": "object",
      "required": ["schema", "dist_id"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "dist_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Dist name (matches wb runtime list output)"
        },
        "updated_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Display name (user-friendly label, may differ from dist_id)"
        },
        "external_source": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "URL or local path where this dist came from. null = built natively."
        },
        "active": {
          "type": "boolean",
          "description": "Mirror of the active-dist symlink state (read via wb dist resolve-alias)"
        },
        "last_built_at": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            { "type": "null" }
          ],
          "description": "When full-build.sh last completed. null for external dists."
        },
        "gpu": {
          "oneOf": [
            { "type": "string", "enum": ["auto", "nvidia", "amd", "intel"] },
            { "type": "null" }
          ],
          "description": "GPU selection override at the dist layer. null = inherit from general."
        },
        "build_profile": {
          "$comment": "Reserved for Phase B — dist management UI",
          "oneOf": [
            { "type": "string", "enum": ["minimal", "standard", "full"] },
            { "type": "null" }
          ]
        },
        "component_versions": {
          "$comment": "Reserved for Phase B — native-dist component builder",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "prefix": {
      "$comment": "Phase B/C/D add additional keys per roadmap decisions/phase-a-to-d-roadmap.md",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/wine-bleeding/wb-runtime/schemas/settings-prefix.schema.json",
      "title": "settings-prefix",
      "description": "Per-prefix settings — $WB_HOME/settings/prefixes/<prefix-id>.json",
      "type": "object",
      "required": ["schema", "prefix_id"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "prefix_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Prefix name"
        },
        "updated_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "notes": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "User-supplied free text for the prefix. Layer-exclusive."
        },
        "gpu": {
          "oneOf": [
            { "type": "string", "enum": ["auto", "nvidia", "amd", "intel"] },
            { "type": "null" }
          ],
          "description": "GPU selection override at the prefix layer. null = inherit."
        },
        "win_version": {
          "oneOf": [
            { "type": "string", "enum": ["win10", "win11", "win8.1", "win8", "win7", "winxp", "vista"] },
            { "type": "null" }
          ],
          "description": "Windows version override at the prefix layer. null = inherit."
        },
        "wine_debug": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "WINEDEBUG override at the prefix layer. null = inherit."
        },
        "winetricks_verbs_installed": {
          "$comment": "Active (Phase D) — verbs reconciled from winetricks.log",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.=+-]+$"
          }
        },
        "dll_overrides": {
          "$comment": "Active (Phase D) — per-prefix DLL override list (structured; NOT env_vars)",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["dll", "mode", "origin"],
                "additionalProperties": false,
                "properties": {
                  "dll": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["native", "builtin", "n,b", "b,n", "disabled"]
                  },
                  "origin": {
                    "type": "string",
                    "enum": ["preset", "user"]
                  }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "components_enabled": {
          "$comment": "Active (Phase D) — per-prefix component toggle (on/off/inherit)",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dxvk":  { "type": "string", "enum": ["on", "off", "inherit"] },
                "vkd3d": { "type": "string", "enum": ["on", "off", "inherit"] },
                "nvapi": { "type": "string", "enum": ["on", "off", "inherit"] }
              }
            },
            { "type": "null" }
          ]
        },
        "wine_registry_patches": {
          "$comment": "Active (Phase D) — bounded undo stack (last 10 wine reg edits)",
          "oneOf": [
            {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": ["key", "name", "type", "prev_data", "new_data", "applied_utc"],
                "additionalProperties": false,
                "properties": {
                  "key":          { "type": "string" },
                  "name":         { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["REG_SZ", "REG_EXPAND_SZ", "REG_DWORD", "REG_QWORD"]
                  },
                  "prev_data":    { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                  "new_data":     { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                  "applied_utc":  { "type": "string" }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "env_vars": {
          "$comment": "Active (Phase D) — prefix-layer env overrides (incl. WB_DXVK/VKD3D/NVAPI managed keys)",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "_wb_prefix_managed_env_keys": {
          "$comment": "Active (Phase D) internal — env_vars keys owned by Phase D bake handler",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "app": {
      "$comment": "Phase B/C/D add additional keys per roadmap decisions/phase-a-to-d-roadmap.md",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/wine-bleeding/wb-runtime/schemas/settings-app.schema.json",
      "title": "settings-app",
      "description": "Per-app settings — $WB_HOME/settings/apps/<app-id>.json",
      "type": "object",
      "required": ["schema", "app_id"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "app_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "UUID from apps.json"
        },
        "updated_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "gpu": {
          "oneOf": [
            { "type": "string", "enum": ["auto", "nvidia", "amd", "intel"] },
            { "type": "null" }
          ],
          "description": "GPU selection override at the app layer. null = inherit."
        },
        "win_version": {
          "oneOf": [
            { "type": "string", "enum": ["win10", "win11", "win8.1", "win8", "win7", "winxp", "vista"] },
            { "type": "null" }
          ],
          "description": "Windows version override at the app layer. null = inherit."
        },
        "wine_debug": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "WINEDEBUG override at the app layer. null = inherit. Empty string is meaningful (silences debug)."
        },
        "wine_args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Extra argv appended to wine <exe>. Layer-exclusive."
        },
        "env_vars": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Extra environment variables for the launch. Layer-exclusive."
        },
        "overlays": {
          "$comment": "Phase C — per-app overlay bundling (MangoHud/VKBasalt/OptiScaler). Active as of v1.8.0.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mangohud": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled":     { "type": "boolean" },
                    "bundled":     { "type": "boolean" },
                    "version":     { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                    "config_path": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
                  }
                },
                "vkbasalt": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "bundled": { "type": "boolean" },
                    "version": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
                  }
                },
                "optiscaler": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "version": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
                  }
                }
              }
            }
          ]
        },
        "_wb_overlay_managed_env_keys": {
          "$comment": "Phase C internal — env_vars keys baked by the overlay save handler. Not user-editable.",
          "type": "array",
          "items": { "type": "string" }
        },
        "wine_registry_patches": {
          "$comment": "Reserved for Phase D — registry edit",
          "oneOf": [
            { "type": "array" },
            { "type": "null" }
          ]
        }
      }
    }

  }
}
