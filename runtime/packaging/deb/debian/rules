#!/usr/bin/make -f
# Debian rules file for wine-bleeding-wb

%:
	dh $@

override_dh_auto_build:
	# Pure shell — nothing to compile.

override_dh_auto_install:
	# deb/build.sh stages the runtime tree into $SRC_STAGE with debian/ at its
	# root; CURDIR is $SRC_STAGE when dpkg-buildpackage runs, so the Makefile
	# is right here. Previously this used ../../.. which was a leftover from
	# an older in-tree layout and produced an empty package.
	make -C $(CURDIR) install \
		DESTDIR=$(CURDIR)/debian/wine-bleeding-wb \
		PREFIX=/usr \
		LIBDIR=/usr/lib \
		SHAREDIR=/usr/share

override_dh_auto_test:
	# Tests require bats-core (git submodule). Skip during package build.
	# Run 'make -C runtime test' separately.
