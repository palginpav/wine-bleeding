[Version]
Signature="$CHICAGO$"
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Class=System

[Manufacturer]
Wine=mfg_section

[mfg_section]
Wine USB bus driver=device_section,root\wineusb

[device_section]
AddReg=usb_iface_class.AddReg

; Device interface class for SetupAPI enumeration (GUID_DEVINTERFACE_USB_DEVICE)
[usb_iface_class.AddReg]
HKLM,System\CurrentControlSet\Control\DeviceClasses\{a5dcbf10-6530-11d2-901f-00c04fb951ed},,0x00000010,

[device_section.Services]
AddService = wineusb,0x2,svc_section

[svc_section]
Description="Wine USB bus driver"
DisplayName="Wine USB bus"
ServiceBinary="%12%\wineusb.sys"
LoadOrderGroup="WinePlugPlay"
ServiceType=1
StartType=3
ErrorControl=1
