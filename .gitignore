# Keep the repository focused on source code, vendored dependency sources,
# and build/publishing scripts. Ignore generated output and local workspace data.

# Top-level configure/build output
/autom4te.cache/
/config.status
/config.log
/compile_commands.json
/Makefile
/loader-wow64
/wine
/TAGS
/tags
/tmp*/
/configure~

# Generated headers and stamps
/include/config.h
/include/stamp-h

# Distribution and local packaging output
/dist/
/tools/publish-release.sh

# In-tree build output
**/i386-windows/
**/x86_64-windows/
**/*.ok

# Editor and local workspace metadata
/.vscode/
/.cursor/
/.idea/
/.vs/
*.swp
*.swo
*~
